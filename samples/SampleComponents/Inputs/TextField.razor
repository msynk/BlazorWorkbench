@namespace SampleComponents.Inputs

@* A labeled text input supporting two-way binding. *@
<div class="field @(Invalid ? "field-invalid" : "")">
    <label for="@_id">@Label@if (Required) { <span aria-hidden="true"> *</span> }</label>
    <input id="@_id" type="@InputType" value="@Value" placeholder="@Placeholder" required="@Required" disabled="@Disabled"
           aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@(HelperText is null ? null : _id + "-help")"
           @oninput="OnInput" />
    @if (HelperText is not null)
    {
        <div id="@(_id + "-help")" class="field-help">@HelperText</div>
    }
</div>

@code {
    private readonly string _id = "tf-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Visible label (required for accessibility).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Current value. Use <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised on every keystroke.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Help or error text shown below the input.</summary>
    [Parameter] public string? HelperText { get; set; }

    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the field invalid (styles the helper text as an error).</summary>
    [Parameter] public bool Invalid { get; set; }

    /// <summary>The HTML input type (text, email, password, ...).</summary>
    [Parameter] public string InputType { get; set; } = "text";

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}

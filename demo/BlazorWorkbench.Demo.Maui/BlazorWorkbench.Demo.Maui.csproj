<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>.NET MAUI Blazor Hybrid Workbench host for the sample component library. Reuses the scenarios of the Interactive Server sample.</Description>
    <!-- Multi-targeted: clear the single target framework from Directory.Build.props. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Android is opt-in (needs the Android SDK): dotnet build -f net10.0-android -p:SampleMauiAndroid=true -->
    <TargetFrameworks Condition="'$(SampleMauiAndroid)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>SampleWorkbench.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- Disable MAUI CSS handling so Blazor can handle it. -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Sample Workbench</ApplicationTitle>
    <ApplicationId>dev.blazorworkbench.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Unpackaged on Windows, so 'dotnet run' and 'workbench test' can start the app directly. -->
    <WindowsPackageType>None</WindowsPackageType>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3F37C9" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3F37C9" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared scenarios refer to sample components named Button, Toolbar and Size, which clash with MAUI types. -->
    <Using Remove="Microsoft.Maui.Controls" />
    <Using Remove="Microsoft.Maui.Graphics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorWorkbench.Maui\BlazorWorkbench.Maui.csproj" />
    <ProjectReference Include="..\..\src\BlazorWorkbench.Maui.Essentials\BlazorWorkbench.Maui.Essentials.csproj" />
    <ProjectReference Include="..\SampleComponents\SampleComponents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One set of scenario sources for every hosting model. -->
    <Compile Include="..\SampleWorkbench\SampleCatalog.cs" Link="SampleCatalog.cs" />
    <Compile Include="..\SampleWorkbench\Scenarios\*.cs" Link="Scenarios\%(Filename)%(Extension)" />
    <Compile Include="..\SampleWorkbench\Fakes\*.cs" Link="Fakes\%(Filename)%(Extension)" />
    <Compile Include="..\SampleWorkbench\Providers\*.cs" Link="Providers\%(Filename)%(Extension)" />
    <RazorComponent Include="..\SampleWorkbench\Editors\HexColorEditor.razor" Link="Editors\HexColorEditor.razor" />
  </ItemGroup>
</Project>

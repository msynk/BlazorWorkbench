@namespace BlazorWorkbench.Demo.Components.Feedback

@* An inline message. Errors and warnings are announced immediately (role="alert"); others politely (role="status"). *@
@if (!_dismissed)
{
    <div class="alert alert-@Severity.ToString().ToLowerInvariant()" role="@(Severity is AlertSeverity.Error or AlertSeverity.Warning ? "alert" : "status")">
        <span class="alert-message">@Message</span>
        @ChildContent
        @if (Dismissible)
        {
            <button type="button" class="alert-close" aria-label="Dismiss" @onclick="Dismiss">×</button>
        }
    </div>
}

@code {
    private bool _dismissed;

    /// <summary>Severity of the message.</summary>
    [Parameter] public AlertSeverity Severity { get; set; } = AlertSeverity.Info;

    /// <summary>The message text.</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = "";

    /// <summary>Optional extra content such as a link.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shows a dismiss button.</summary>
    [Parameter] public bool Dismissible { get; set; }

    /// <summary>Raised after the alert is dismissed.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    private async Task Dismiss()
    {
        _dismissed = true;
        await OnDismiss.InvokeAsync();
    }
}

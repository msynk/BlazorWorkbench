<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>Demo component library used to demonstrate and test Blazor Workbench.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <!-- IHttpClientFactory (ProductSearch uses a named client). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- The Device components use .NET MAUI Essentials interfaces (the platform-neutral net10.0 assembly). -->
    <PackageReference Include="Microsoft.Maui.Essentials" />
  </ItemGroup>
</Project>

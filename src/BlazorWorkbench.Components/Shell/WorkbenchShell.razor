@page "/"
@page "/scenario/{ScenarioId}"
@page "/docs/{ComponentId}"
@page "/pages/{PageId}"
@page "/tokens"
@implements IAsyncDisposable
@inject WorkbenchCatalogAccessor Catalogs
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@PageTitleText</PageTitle>

<div class="wb-shell @(_focusMode && _scenario is not null ? "wb-focus-mode" : "") @(_panelRight ? "wb-panel-right" : "")" data-shell-theme="@_shellTheme">
    <VisionFilters />
    <header class="wb-header">
        <a class="wb-brand" href="">
            <span class="wb-logo" aria-hidden="true">◧</span>
            <span>@Options.Title</span>
        </a>
        @if (_scenario is not null && ComponentId is null)
        {
            <div class="wb-toolbar" role="toolbar" aria-label="Preview environment">
                <label class="wb-field">
                    <span>Theme</span>
                    <select id="wb-theme" @bind="ThemeName" @bind:after="OnThemeChanged">
                        @foreach (var t in Options.Themes)
                        {
                            <option value="@t.Name">@t.Name</option>
                        }
                    </select>
                </label>
                <label class="wb-field">
                    <span>Culture</span>
                    <select id="wb-culture" @bind="CultureName" @bind:after="OnCultureChanged">
                        <option value="">Scenario default@(_scenario.Environment.Culture is { } c ? $" ({c})" : "")</option>
                        @foreach (var culture in Options.Cultures)
                        {
                            <option value="@culture">@culture</option>
                        }
                    </select>
                </label>
                <label class="wb-field">
                    <span>Direction</span>
                    <select id="wb-direction" @bind="Direction" @bind:after="OnDirectionChanged">
                        <option value="">Auto</option>
                        <option value="ltr">LTR</option>
                        <option value="rtl">RTL</option>
                    </select>
                </label>
                <label class="wb-field" title="Preview the scenario as another simulated user">
                    <span>User</span>
                    <select id="wb-user" @bind="UserName" @bind:after="OnSessionOptionChanged">
                        <option value="">Scenario default@(_scenario.Environment.User is { } u ? $" ({(u.IsAuthenticated ? u.Name ?? "user" : "signed out")})" : "")</option>
                        <option value="anonymous">Signed out</option>
                        @foreach (var user in Options.Users)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </select>
                </label>
                <label class="wb-field" title="Slow down or cut off the fake HTTP backend">
                    <span>Network</span>
                    <select id="wb-network" @bind="NetworkName" @bind:after="OnSessionOptionChanged">
                        <option value="">As declared</option>
                        @foreach (var profile in Options.NetworkProfiles)
                        {
                            <option value="@profile.Id">@profile.Name</option>
                        }
                    </select>
                </label>
                <span class="wb-toolbar-spacer"></span>
                <button type="button" class="wb-button" title="Reload the preview, keeping changes (R)" @onclick="Reload">Reload</button>
                <button type="button" class="wb-button" title="Reset to the scenario's declared state (Shift+R)" @onclick="Reset">Reset</button>
                <button type="button" class="wb-button" title="Copy a link to this exact state" @onclick="CopyLink">@(_linkCopied ? "Copied" : "Copy link")</button>
                <a class="wb-button" href="@FrameSource" target="_blank" rel="noopener">Open ↗</a>
                @ShellButtons
            </div>
        }
        else
        {
            <div class="wb-toolbar"><span class="wb-toolbar-spacer"></span>@ShellButtons</div>
        }
    </header>

    <aside class="wb-sidebar" aria-label="Component explorer">
        <Explorer Catalog="Catalog" SelectedScenarioId="@_scenario?.Id" SelectedComponentId="@ComponentId" SelectedPageId="@PageId" Recent="_recent" />
    </aside>

    <main class="wb-main" id="wb-main">
        @if (ComponentId is not null)
        {
            @if (Catalog.FindComponent(ComponentId) is { } docComponent)
            {
                <ComponentDocs Component="docComponent" Catalog="Catalog" PreviewTheme="@ShellMatchedTheme" />
            }
            else
            {
                <div class="wb-empty" role="alert">Component '@ComponentId' was not found.</div>
            }
        }
        else if (PageId is not null)
        {
            @if (Catalog.FindPage(PageId) is { } docPage)
            {
                <article class="wb-docs wb-page">
                    <div class="wb-crumbs">@string.Join(" / ", docPage.Path.SkipLast(1))</div>
                    <h1 class="wb-title">@docPage.DisplayName</h1>
                    <MarkdownView Markdown="@docPage.Markdown" Catalog="Catalog" PreviewTheme="@ShellMatchedTheme" />
                </article>
            }
            else
            {
                <div class="wb-empty" role="alert">Page '@PageId' was not found.</div>
            }
        }
        else if (IsTokensPage)
        {
            <article class="wb-docs wb-page">
                <h1 class="wb-title">Design tokens</h1>
                <p class="wb-lead">The CSS custom properties defined by the preview stylesheets, with their values in each theme. Workbench reads them from the stylesheets; nothing needs to be declared.</p>
                <MarkdownView Markdown="{{tokens}}" Catalog="Catalog" PreviewTheme="@ShellMatchedTheme" />
            </article>
        }
        else if (_scenario is null)
        {
            @if (ScenarioId is not null)
            {
                <div class="wb-empty" role="alert">
                    <h2>Scenario '@ScenarioId' was not found</h2>
                    <p>It may have been renamed. Scenario ids are <code>component-id--scenario-key</code>.</p>
                </div>
            }
            <Overview Catalog="Catalog" />
        }
        else
        {
            <section class="wb-stage" aria-label="Preview">
                <div class="wb-stage-header">
                    <div>
                        <div class="wb-crumbs">@(_component?.Title.Replace("/", " / ")) @if (_component?.Status is { } status) { <StatusBadge Status="status" Compact="true" /> }</div>
                        <h1 class="wb-title">@_scenario.Name
                            @if (_scenario.IsGenerated) { <span class="wb-badge" title="No scenarios are declared for this component">generated</span> }
                            @foreach (var tag in _scenario.Tags) { <span class="wb-badge wb-tag-@tag">@tag</span> }
                        </h1>
                        @if (_scenario.Description is { } description) { <p class="wb-muted wb-description">@description</p> }
                        @if (_scenario.Notes is { } notes)
                        {
                            <details class="wb-notes-block" open>
                                <summary>Notes</summary>
                                <MarkdownView Markdown="@notes" Catalog="Catalog" PreviewTheme="@ShellMatchedTheme" CssClass="wb-notes" />
                            </details>
                        }
                        <ScenarioFactList Facts="_facts" OnOpen="SelectTab" IdPrefix="wb-stage-facts" />
                    </div>
                    <div class="wb-stage-status">
                        <div class="wb-segmented" role="radiogroup" aria-label="Canvas mode">
                            @foreach (var (key, label) in Modes)
                            {
                                <label class="@(_mode == key ? "active" : "")"><input type="radio" name="wb-mode" value="@key" checked="@(_mode == key)" @onchange="() => SetMode(key)" /> @label</label>
                            }
                        </div>
                        @if (_mode == "canvas")
                        {
                            <span class="wb-state wb-state-@_previewState" role="status">@StateText</span>
                        }
                        @if (_mode == "canvas" && _metrics?.ReadyMs is { } ready) { <span class="wb-muted" title="Time from navigation start until ready">ready in @ready.ToString("0") ms · @_metrics.DomUpdates DOM updates</span> }
                        <a class="wb-link" href="@($"docs/{_component?.Id}")">Docs</a>
                    </div>
                </div>
                @if (_scenarioIssues.Count > 0)
                {
                    <ul class="wb-issues" aria-label="Scenario issues">
                        @foreach (var issue in _scenarioIssues)
                        {
                            <li class="wb-issue wb-sev-@issue.Severity.ToString().ToLowerInvariant()"><code>@issue.Code</code> @issue.Message @if (issue.Remedy is { } remedy) { <span class="wb-muted"> — @remedy</span> }</li>
                        }
                    </ul>
                }
                @switch (_mode)
                {
                    case "compare":
                        <ViewportBar Options="Options" ViewportName="@ViewportName" Width="CurrentWidth" Height="CurrentHeight" Rotate="_tools.Rotate" Touch="EffectiveTouch"
                                     Canvas="false" OnViewport="OnViewportPreset" OnSize="OnViewportSize" OnSetWidth="SetWidth" OnRotate="RotateViewport" OnTouch="SetTouch" />
                        <CompareView Scenario="_scenario" Options="Options" BuildUrl="CompareUrl" Viewport="EffectiveViewport" InitialAxis="@CompareQuery" Breakpoints="_marks" />
                        break;
                    case "gallery":
                        <GalleryView Component="_component!" SelectedScenarioId="@_scenario.Id" PreviewTheme="@ShellMatchedTheme" />
                        break;
                    default:
                        <CanvasToolbar Tools="_tools" Options="Options" ToolsChanged="OnToolsChanged" OnLayout="OnLayout"
                                       CanFit="@(EffectiveViewport is not null)" OnFit="FitZoom" PanelRight="_panelRight" FocusMode="_focusMode" />
                        <ViewportBar Options="Options" ViewportName="@ViewportName" Width="CurrentWidth" Height="CurrentHeight" Rotate="_tools.Rotate" Touch="EffectiveTouch"
                                     Breakpoints="_marks" Layout="_layout" OnViewport="OnViewportPreset" OnSize="OnViewportSize" OnSetWidth="SetWidth"
                                     OnRotate="RotateViewport" OnTouch="SetTouch" OnHighlightOverflow="HighlightOverflow" />
                        <div class="wb-frame-area @(EffectiveViewport is null ? "wb-frame-responsive" : "")">
                            <div class="wb-device-stack">
                                <BreakpointRuler Marks="_marks" Presets="Options.Viewports" Zoom="_tools.Zoom" CurrentWidth="CurrentWidth" OnSelect="SetWidth" />
                                <div class="wb-device" data-zoom="@Z" data-width="@CurrentWidth" data-height="@CurrentHeight">
                                    <div class="wb-zoom @(EffectiveViewport is null ? "wb-zoom-fill" : "")" style="@ZoomStyle">
                                        <iframe id="wb-preview-frame" title="Preview of @_scenario.Name" src="@_frameSrc"
                                                style="@FrameStyle" class="wb-frame"></iframe>
                                    </div>
                                    @* Drag to resize; the arrow keys change the size by 1 px (Shift: 10 px). The resize runs in workbench-shell.js. *@
                                    <div class="wb-resize wb-resize-e" data-resize="e" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Viewport width"
                                         aria-valuenow="@CurrentWidth" aria-valuemin="@BreakpointPreset.MinViewportWidth" aria-valuemax="@BreakpointPreset.MaxViewportSize"
                                         title="Drag to change the width. Arrow keys: 1 px, Shift: 10 px."></div>
                                    <div class="wb-resize wb-resize-s" data-resize="s" role="separator" tabindex="0" aria-orientation="horizontal" aria-label="Viewport height"
                                         aria-valuenow="@CurrentHeight" aria-valuemin="@BreakpointPreset.MinViewportWidth" aria-valuemax="@BreakpointPreset.MaxViewportSize"
                                         title="Drag to change the height. Arrow keys: 1 px, Shift: 10 px."></div>
                                    <div class="wb-resize wb-resize-se" data-resize="se" aria-hidden="true" title="Drag to change the size"></div>
                                </div>
                            </div>
                        </div>
                        break;
                }
            </section>

            <section class="wb-panel" aria-label="Scenario tools">
                <div class="wb-tabs" role="tablist">
                    @foreach (var (key, label) in Tabs)
                    {
                        <button type="button" role="tab" id="wb-tab-@key" aria-selected="@(_tab == key ? "true" : "false")" aria-controls="wb-tabpanel"
                                class="wb-tab @(_tab == key ? "active" : "")" @onclick="() => SelectTab(key)">
                            @label
                            @if (TabCount(key) is > 0 and var n) { <span class="wb-count @(key == "diagnostics" && HasErrors ? "wb-count-error" : "")">@n</span> }
                        </button>
                    }
                </div>
                <div class="wb-tabpanel" role="tabpanel" id="wb-tabpanel" aria-labelledby="wb-tab-@_tab">
                    @switch (_tab)
                    {
                        case "controls":
                            <ParameterInspector Component="_component!" Scenario="_scenario" Overrides="_overrides" ArgErrors="_argErrors"
                                                OverridesChanged="OnOverridesChanged" CallbackCounts="_callbackCounts" />
                            break;
                        case "environment":
                            <EnvironmentPanel Scenario="_scenario" Component="_component!" Options="Options" Gates="_gates" Session="_session"
                                              OnGate="SendGate" OnAdvanceClock="AdvanceClock" OnRefresh="RequestSession" />
                            break;
                        case "actions":
                            <ActionsPanel Callbacks="_callbacks" OnClear="() => { _callbacks.Clear(); _callbackCounts.Clear(); }" />
                            break;
                        case "diagnostics":
                            <DiagnosticsPanel Diagnostics="_diagnostics" OnClear="() => _diagnostics.Clear()" />
                            break;
                        case "interactions":
                            <InteractionsPanel Scenario="_scenario" Results="_interactionResults" Running="@_runningInteraction" Paused="_paused"
                                               OnRun="RunInteraction" OnContinue="ContinueInteraction"
                                               Recording="_recording" AssertMode="_assertMode" Recorded="_recorded" OnRecord="Record" OnClearRecording="() => _recorded.Clear()" />
                            break;
                        case "accessibility":
                            <AccessibilityPanel Result="_a11y" Running="_a11yRunning" Scenario="_scenario" OnRun="RunAccessibility" OnHighlight="Highlight" />
                            break;
                        case "visual":
                            <VisualPanel ScenarioId="@_scenario.Id" />
                            break;
                        case "design":
                            <DesignPanel Designs="_scenario.Designs" Tools="_tools" ToolsChanged="OnToolsChanged" />
                            break;
                        case "html":
                            <HtmlPanel Html="@_html" OnRefresh="RequestHtml" />
                            break;
                        case "storage":
                            <StoragePanel Snapshot="_storage" Declared="_scenario.Environment.Storage" Isolated="Options.IsolateBrowserStorage" OnCommand="SendStorage" />
                            break;
                        case "code":
                            <CodePanel Scenario="_scenario" Component="_component!" Overrides="_overrides" />
                            break;
                    }
                </div>
            </section>
        }
    </main>

    @if (_shortcutsOpen)
    {
        <ShortcutsDialog OnClose="() => _shortcutsOpen = false" />
    }
</div>

@code {
    private const string CustomViewport = "custom";

    private static readonly (string Key, string Label)[] AllTabs =
    [
        ("controls", "Controls"), ("environment", "Environment"), ("actions", "Actions"), ("diagnostics", "Diagnostics"),
        ("interactions", "Interactions"), ("accessibility", "Accessibility"), ("visual", "Visual"), ("design", "Design"),
        ("html", "HTML"), ("storage", "Storage"), ("code", "Code"),
    ];

    private static readonly (string Key, string Label)[] Modes = [("canvas", "Canvas"), ("compare", "Compare"), ("gallery", "Gallery")];

    private IJSObjectReference? _module;
    private DotNetObjectReference<WorkbenchShell>? _self;
    private ScenarioDefinition? _scenario;
    private ComponentEntry? _component;
    private List<CatalogIssue> _scenarioIssues = [];
    private IReadOnlyList<ScenarioFact> _facts = [];
    private Dictionary<string, ArgOverride> _overrides = new(StringComparer.Ordinal);
    private Dictionary<string, string> _argErrors = new(StringComparer.Ordinal);
    private readonly List<DiagnosticDto> _diagnostics = [];
    private readonly List<CallbackEntry> _callbacks = [];
    private readonly Dictionary<string, int> _callbackCounts = new(StringComparer.Ordinal);
    private List<GateInfo> _gates = [];
    private JsonElement? _session;
    private readonly Dictionary<string, InteractionOutcome> _interactionResults = new(StringComparer.Ordinal);
    private string? _runningInteraction;
    private string? _pendingInteraction;
    private bool _pendingDebug;
    private (string Name, int Index)? _paused;
    private bool _recording;
    private bool _assertMode;
    private readonly List<InteractionStep> _recorded = [];
    private A11yOutcome? _a11y;
    private bool _a11yRunning;
    private bool _pendingA11y;
    private string? _html;
    private StorageSnapshot? _storage;
    private PreviewMetrics? _metrics;
    private string _previewState = "loading";
    private string _frameSrc = "about:blank";
    private string _tab = "controls";
    private string _mode = "canvas";
    private string _shellTheme = "light";
    // True while the preview theme is not chosen by the URL, the scenario or the user: it then follows the Workbench theme.
    private bool _themeFollowsShell = true;
    private ViewportPreset? _viewport;
    private int _customWidth = 390, _customHeight = 844;
    // Touch emulation chosen in the viewport bar; null follows the preset (mobile presets emulate touch).
    private bool? _touch;
    private bool _sentTouch;
    private LayoutReport? _layout;
    private List<DetectedBreakpoint> _detected = [];
    private IReadOnlyList<BreakpointMark> _marks = [];
    private string? _loadedScenarioId;
    private PreviewTools _tools = PreviewTools.None;
    private bool _focusMode;
    private bool _panelRight;
    private bool _shortcutsOpen;
    private bool _linkCopied;
    private List<string> _recent = [];

    [Parameter] public string? ScenarioId { get; set; }
    [Parameter] public string? ComponentId { get; set; }
    [Parameter] public string? PageId { get; set; }
    [SupplyParameterFromQuery(Name = "args")] public string? ArgsQuery { get; set; }
    [SupplyParameterFromQuery(Name = "viewport")] public string? ViewportQuery { get; set; }
    [SupplyParameterFromQuery(Name = "theme")] public string? ThemeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "culture")] public string? CultureQuery { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirQuery { get; set; }
    [SupplyParameterFromQuery(Name = "user")] public string? UserQuery { get; set; }
    [SupplyParameterFromQuery(Name = "network")] public string? NetworkQuery { get; set; }
    [SupplyParameterFromQuery(Name = "panel")] public string? PanelQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "compare")] public string? CompareQuery { get; set; }
    [SupplyParameterFromQuery(Name = "touch")] public string? TouchQuery { get; set; }

    private WorkbenchCatalog Catalog => Catalogs.Catalog;
    private WorkbenchOptions Options => Catalogs.Options;
    private string ViewportName { get; set; } = "";
    private string ThemeName { get; set; } = "";
    private string CultureName { get; set; } = "";
    private string Direction { get; set; } = "";
    private string UserName { get; set; } = "";
    private string NetworkName { get; set; } = "";
    private bool HasErrors => _diagnostics.Any(d => d.Severity == DiagnosticSeverity.Error);
    private bool IsTokensPage => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/') == "tokens";

    private IEnumerable<(string Key, string Label)> Tabs => AllTabs.Where(t => t.Key != "design" || _scenario?.Designs.Count > 0);

    private string PageTitleText => ComponentId is not null
        ? $"{Catalog.FindComponent(ComponentId)?.DisplayName ?? "Docs"} · {Options.Title}"
        : PageId is not null ? $"{Catalog.FindPage(PageId)?.DisplayName ?? "Page"} · {Options.Title}"
        : IsTokensPage ? $"Design tokens · {Options.Title}"
        : _scenario is not null ? $"{_component?.DisplayName} / {_scenario.Name} · {Options.Title}" : Options.Title;

    private string StateText => _previewState switch
    {
        "ready" => "Ready",
        "error" => "Error",
        "loading" => "Loading…",
        _ => _previewState,
    };

    /// <summary>The preview theme matching the Workbench theme: the first theme with the same color scheme, else the first theme.</summary>
    private string ShellMatchedTheme =>
        (Options.Themes.FirstOrDefault(t => t.ColorScheme == (_shellTheme == "dark" ? ColorScheme.Dark : ColorScheme.Light)) ?? Options.Themes.FirstOrDefault())?.Name ?? "";

    /// <summary>The fixed viewport after rotation, or null for a responsive preview.</summary>
    private ViewportPreset? EffectiveViewport
    {
        get
        {
            var viewport = ViewportName == CustomViewport ? new ViewportPreset("custom", _customWidth, _customHeight) : _viewport;
            return viewport is not null && _tools.Rotate ? viewport with { Width = viewport.Height, Height = viewport.Width } : viewport;
        }
    }

    /// <summary>The viewport width shown in the viewport bar: the fixed width, or the measured width of a responsive preview.</summary>
    private int? CurrentWidth => EffectiveViewport?.Width ?? (_layout is { Width: > 0 } l ? (int)Math.Round(l.Width) : null);

    private int? CurrentHeight => EffectiveViewport?.Height ?? (_layout is { Height: > 0 } l ? (int)Math.Round(l.Height) : null);

    /// <summary>Touch emulation as chosen, else on for mobile presets.</summary>
    private bool EffectiveTouch => _touch ?? (ViewportName != CustomViewport && _viewport?.IsMobile == true);

    private string Z => _tools.Zoom.ToString("0.###", CultureInfo.InvariantCulture);

    private string ZoomStyle => EffectiveViewport is { } v
        ? $"width:{(v.Width * _tools.Zoom).ToString("0.##", CultureInfo.InvariantCulture)}px;height:{(v.Height * _tools.Zoom).ToString("0.##", CultureInfo.InvariantCulture)}px;"
        : "";

    private string FrameStyle
    {
        get
        {
            var filter = _tools.VisionFilter is { } f ? $"filter:{f};" : "";
            var scale = _tools.Zoom == 1 ? "" : $"transform:scale({Z});transform-origin:0 0;";
            if (EffectiveViewport is { } v)
                return $"width:{v.Width}px;height:{v.Height}px;{scale}{filter}";
            if (_tools.Zoom == 1)
                return filter;
            var percent = (100 / _tools.Zoom).ToString("0.###", CultureInfo.InvariantCulture);
            return $"position:absolute;left:0;top:0;width:{percent}%;height:{percent}%;{scale}{filter}";
        }
    }

    private string FrameSource => _scenario is null ? "about:blank" : BuildPreviewUrl(includeArgs: true);

    private RenderFragment ShellButtons => __builder =>
    {
        <button type="button" class="wb-button" @onclick="() => _shortcutsOpen = true" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">?</button>
        <button type="button" class="wb-button" @onclick="ToggleShellTheme" aria-label="Toggle Workbench theme">@(_shellTheme == "dark" ? "☀" : "☾")</button>
    };

    protected override void OnInitialized()
    {
        Catalogs.Changed += OnCatalogChanged;
        _marks = ResponsiveLayout.Merge(Options.Breakpoints, _detected);
    }

    protected override void OnParametersSet()
    {
        _scenario = ScenarioId is null ? null : Catalog.FindScenario(ScenarioId);
        _component = _scenario is null ? null : Catalog.GetComponentOf(_scenario);
        if (_scenario?.Id == _loadedScenarioId && _scenario is not null)
            return;

        _loadedScenarioId = _scenario?.Id;
        ResetLiveState();
        if (_scenario is null)
            return;

        _scenarioIssues = Catalog.IssuesFor(_scenario).Where(i => i.Severity != IssueSeverity.Info).ToList();
        _facts = ScenarioFacts.Describe(_scenario, Options);
        try { _overrides = ArgsCodec.Decode(ArgsQuery); }
        catch (Exception ex) when (ex is JsonException or FormatException) { _overrides = new(StringComparer.Ordinal); }

        var query = ParseQuery(Navigation.Uri);
        _tools = PreviewTools.Parse(key => query.GetValueOrDefault(key));
        if (ViewportQuery is { } vq && TryParseSize(vq, out var w, out var h))
        {
            ViewportName = CustomViewport;
            (_customWidth, _customHeight) = (w, h);
            _viewport = null;
        }
        else
        {
            ViewportName = Options.FindViewport(ViewportQuery ?? _scenario.Environment.Viewport)?.Name ?? "";
            _viewport = Options.FindViewport(ViewportName);
        }

        _touch = TouchQuery switch { "1" => true, "0" => false, _ => null };
        ApplyDeclaredTheme();
        CultureName = CultureQuery ?? "";
        Direction = DirQuery is "ltr" or "rtl" ? DirQuery : "";
        UserName = UserQuery is { } uq && (uq == "anonymous" || Options.FindUser(uq) is not null) ? Options.FindUser(uq)?.Id ?? "anonymous" : "";
        NetworkName = Options.FindNetworkProfile(NetworkQuery)?.Id ?? "";
        if (PanelQuery is { } panel && Tabs.Any(t => t.Key == panel))
            _tab = panel;
        if (ModeQuery is { } mode && Modes.Any(m => m.Key == mode))
            _mode = mode;
        _frameSrc = BuildPreviewUrl(includeArgs: true);
        _sentTouch = EffectiveTouch;
        RememberRecent(_scenario.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorWorkbench.Components/workbench-shell.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _self);
            // A theme the user chose earlier, otherwise the operating system's color scheme.
            var theme = await _module.InvokeAsync<string?>("getPreference", "shell-theme");
            if (theme is not ("dark" or "light"))
                theme = await _module.InvokeAsync<string?>("getSystemTheme");
            _panelRight = await _module.InvokeAsync<string?>("getPreference", "panel-position") == "right";
            var recent = await _module.InvokeAsync<string?>("getPreference", "recent");
            var current = _recent;
            _recent = (recent ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
            foreach (var id in current.AsEnumerable().Reverse())
                RememberRecent(id);
            if (theme is "dark" or "light" && theme != _shellTheme)
            {
                _shellTheme = theme;
                if (_scenario is not null && _themeFollowsShell && ThemeName != ShellMatchedTheme)
                {
                    // The preview has only started loading and may not listen for messages yet: load it with the theme.
                    ThemeName = ShellMatchedTheme;
                    _frameSrc = BuildPreviewUrl(includeArgs: true);
                }
            }

            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Uses the theme from the URL or the scenario; without one, the preview follows the Workbench theme.</summary>
    private void ApplyDeclaredTheme(bool useQuery = true)
    {
        var declared = Options.FindTheme((useQuery ? ThemeQuery : null) ?? _scenario?.Environment.Theme)?.Name;
        _themeFollowsShell = declared is null;
        ThemeName = declared ?? ShellMatchedTheme;
    }

    private void ResetLiveState()
    {
        _diagnostics.Clear();
        _callbacks.Clear();
        _callbackCounts.Clear();
        _gates = [];
        _session = null;
        _interactionResults.Clear();
        _runningInteraction = null;
        _pendingInteraction = null;
        _paused = null;
        _recording = false;
        _assertMode = false;
        _recorded.Clear();
        _a11y = null;
        _a11yRunning = false;
        _pendingA11y = false;
        _html = null;
        _storage = null;
        _argErrors = new(StringComparer.Ordinal);
        _metrics = null;
        _previewState = "loading";
        _scenarioIssues = [];
        _facts = [];
        _mode = "canvas";
        // Breakpoints belong to the stylesheets, which scenarios share: they stay until the next preview reports its own.
        _layout = null;
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        var index = uri.IndexOf('?');
        if (index < 0)
            return result;
        foreach (var part in uri[(index + 1)..].Split('#')[0].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            var key = Uri.UnescapeDataString(eq < 0 ? part : part[..eq]);
            result[key] = eq < 0 ? "" : Uri.UnescapeDataString(part[(eq + 1)..].Replace('+', ' '));
        }

        return result;
    }

    private static bool TryParseSize(string text, out int width, out int height)
    {
        width = height = 0;
        var parts = text.Split('x', 'X', '×');
        return parts.Length == 2 &&
               int.TryParse(parts[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out width) &&
               int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out height) &&
               width is >= 120 and <= 3840 && height is >= 120 and <= 3840;
    }

    private string? BackgroundValue => _tools.Background is { } id ? Options.Backgrounds.FirstOrDefault(b => b.Id == id)?.Value : null;

    private string BuildPreviewUrl(bool includeArgs, CompareCell? cell = null)
    {
        var query = new List<string>();
        if (includeArgs && _overrides.Count > 0) query.Add("args=" + Uri.EscapeDataString(ArgsCodec.Encode(_overrides)));
        var culture = cell?.Axis == "culture" ? cell.Value : CultureName;
        var theme = cell?.Axis == "theme" ? cell.Value : ThemeName;
        var dir = cell?.Axis == "direction" ? cell.Value : Direction;
        var user = cell?.Axis == "user" ? cell.Value : UserName;
        var network = cell?.Axis == "network" ? cell.Value : NetworkName;
        if (culture.Length > 0) query.Add("culture=" + Uri.EscapeDataString(culture));
        if (theme.Length > 0) query.Add("theme=" + Uri.EscapeDataString(theme));
        if (dir.Length > 0) query.Add("dir=" + dir);
        if (user.Length > 0) query.Add("user=" + Uri.EscapeDataString(user));
        if (network.Length > 0) query.Add("network=" + Uri.EscapeDataString(network));
        var touch = cell?.Axis == "viewport" ? _touch ?? Options.FindViewport(cell.Value)?.IsMobile == true : EffectiveTouch;
        if (touch) query.Add("touch=1");
        var tools = cell is null ? _tools : cell.Axis == "state" ? _tools with { Pseudo = cell.Value.Length > 0 ? [cell.Value] : [] } : _tools;
        query.AddRange(tools.PreviewQuery(BackgroundValue));
        return $"_workbench/preview/{Uri.EscapeDataString(_scenario!.Id)}" + (query.Count > 0 ? "?" + string.Join('&', query) : "");
    }

    private string CompareUrl(CompareCell cell) => BuildPreviewUrl(includeArgs: true, cell);

    private void UpdateAddress()
    {
        if (_scenario is null)
            return;
        var query = new List<string>();
        if (_overrides.Count > 0) query.Add("args=" + Uri.EscapeDataString(ArgsCodec.Encode(_overrides)));
        if (ViewportName == CustomViewport) query.Add($"viewport={_customWidth}x{_customHeight}");
        else if (ViewportName.Length > 0) query.Add("viewport=" + Uri.EscapeDataString(ViewportName));
        if (_touch is { } touch) query.Add("touch=" + (touch ? "1" : "0"));
        if (!_themeFollowsShell && ThemeName.Length > 0 && ThemeName != Options.FindTheme(_scenario.Environment.Theme)?.Name)
            query.Add("theme=" + Uri.EscapeDataString(ThemeName));
        if (CultureName.Length > 0) query.Add("culture=" + Uri.EscapeDataString(CultureName));
        if (Direction.Length > 0) query.Add("dir=" + Direction);
        if (UserName.Length > 0) query.Add("user=" + Uri.EscapeDataString(UserName));
        if (NetworkName.Length > 0) query.Add("network=" + Uri.EscapeDataString(NetworkName));
        query.AddRange(_tools.ToQuery());
        if (_mode != "canvas") query.Add("mode=" + _mode);
        if (_tab != "controls") query.Add("panel=" + _tab);
        Navigation.NavigateTo($"scenario/{Uri.EscapeDataString(_scenario.Id)}" + (query.Count > 0 ? "?" + string.Join('&', query) : ""), replace: true);
    }

    private async Task Post(string type, object? payload)
    {
        if (_module is null)
            return;
        try { await _module.InvokeVoidAsync("post", type, payload); }
        catch (JSDisconnectedException) { }
    }

    private async Task ReloadFrame(bool keepArgs)
    {
        _previewState = "loading";
        _metrics = null;
        _diagnostics.Clear();
        _callbacks.Clear();
        _callbackCounts.Clear();
        _gates = [];
        _paused = null;
        _recording = false;
        _assertMode = false;
        var url = BuildPreviewUrl(keepArgs);
        _sentTouch = EffectiveTouch;
        _frameSrc = url + (url.Contains('?') ? "&" : "?") + "r=" + System.Environment.TickCount64;
        StateHasChanged();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("reloadFrame", _frameSrc); }
            catch (JSDisconnectedException) { }
        }
    }

    private Task Reload() => ReloadFrame(keepArgs: true);

    private async Task Reset()
    {
        _overrides = new(StringComparer.Ordinal);
        _argErrors = new(StringComparer.Ordinal);
        CultureName = "";
        Direction = "";
        UserName = "";
        NetworkName = "";
        _touch = null;
        _tools = PreviewTools.None;
        ApplyDeclaredTheme(useQuery: false);
        await ReloadFrame(keepArgs: false);
        UpdateAddress();
    }

    private async Task CopyLink()
    {
        if (_module is null)
            return;
        try { _linkCopied = await _module.InvokeAsync<bool>("copy", Navigation.Uri); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task OnShortcut(string action) => InvokeAsync(async () =>
    {
        switch (action)
        {
            case "shortcuts": _shortcutsOpen = !_shortcutsOpen; break;
            case "escape": _shortcutsOpen = false; break;
            case "focus" or "panel": await OnLayout(action); break;
            case "previous-scenario" or "next-scenario" or "previous-component" or "next-component": Step(action); break;
        }

        if (_scenario is null || _mode != "canvas" && action is not ("reload" or "reset"))
        {
            StateHasChanged();
            return;
        }

        switch (action)
        {
            case "reset": await Reset(); break;
            case "reload": await Reload(); break;
            case "grid": await OnToolsChanged(_tools with { Grid = !_tools.Grid }); break;
            case "outline": await OnToolsChanged(_tools with { Outline = !_tools.Outline }); break;
            case "measure": await OnToolsChanged(_tools with { Measure = !_tools.Measure }); break;
            case "zoom-in": await OnToolsChanged(_tools with { Zoom = PreviewTools.ZoomLevels.FirstOrDefault(l => l > _tools.Zoom + 0.001, PreviewTools.ZoomLevels[^1]) }); break;
            case "zoom-out": await OnToolsChanged(_tools with { Zoom = PreviewTools.ZoomLevels.LastOrDefault(l => l < _tools.Zoom - 0.001, PreviewTools.ZoomLevels[0]) }); break;
            case "zoom-reset": await OnToolsChanged(_tools with { Zoom = 1 }); break;
            case "zoom-fit": await FitZoom(); break;
        }

        StateHasChanged();
    });

    /// <summary>Moves to the previous or next scenario (Alt+←/→) or component (Alt+↑/↓) in explorer order.</summary>
    private void Step(string action)
    {
        var scenarios = Catalog.Components.SelectMany(c => c.Scenarios).ToList();
        if (scenarios.Count == 0)
            return;
        var index = _scenario is null ? -1 : scenarios.FindIndex(s => s.Id == _scenario.Id);
        ScenarioDefinition? target = null;
        if (action is "next-scenario" or "previous-scenario")
        {
            var next = action == "next-scenario" ? index + 1 : index - 1;
            target = scenarios[(next + scenarios.Count) % scenarios.Count];
        }
        else
        {
            var components = Catalog.Components;
            var current = _component is null ? -1 : components.ToList().IndexOf(_component);
            var next = action == "next-component" ? current + 1 : current - 1;
            target = components[(next + components.Count) % components.Count].Scenarios.FirstOrDefault();
        }

        if (target is not null)
            Navigation.NavigateTo($"scenario/{Uri.EscapeDataString(target.Id)}");
    }

    private async Task OnOverridesChanged(Dictionary<string, ArgOverride> overrides)
    {
        _overrides = overrides;
        await Post("args", JsonSerializer.Deserialize<JsonElement>(ArgsCodec.Encode(_overrides)));
        UpdateAddress();
    }

    private async Task OnViewportPreset(string name)
    {
        if (name == CustomViewport)
        {
            // Custom starts from the size on screen.
            (_customWidth, _customHeight) = (CurrentWidth ?? _customWidth, CurrentHeight ?? _customHeight);
            KeepPresetTouch();
            ViewportName = CustomViewport;
            _viewport = null;
            _tools = _tools with { Rotate = false };
        }
        else
        {
            // A preset brings its own input: touch for mobile presets, a mouse otherwise.
            _touch = null;
            _viewport = Options.FindViewport(name);
            ViewportName = _viewport?.Name ?? "";
            if (_viewport is null)
                _tools = _tools with { Rotate = false };
        }

        await SyncDeviceAsync();
        UpdateAddress();
    }

    /// <summary>Fixes the viewport at a size: a drag, the size fields, the ruler or the Breakpoints menu.</summary>
    private async Task ApplySize(int width, int height)
    {
        KeepPresetTouch();
        ViewportName = CustomViewport;
        _viewport = null;
        _customWidth = Math.Clamp(width, BreakpointPreset.MinViewportWidth, BreakpointPreset.MaxViewportSize);
        _customHeight = Math.Clamp(height, BreakpointPreset.MinViewportWidth, BreakpointPreset.MaxViewportSize);
        _tools = _tools with { Rotate = false };
        await SyncDeviceAsync();
        UpdateAddress();
    }

    /// <summary>A mobile preset turned into a custom size stays a touch device, as in browser developer tools.</summary>
    private void KeepPresetTouch()
    {
        if (_touch is null && ViewportName != CustomViewport && _viewport?.IsMobile == true)
            _touch = true;
    }

    private Task OnViewportSize((int Width, int Height) size) => ApplySize(size.Width, size.Height);

    private Task SetWidth(int width) => ApplySize(width, CurrentHeight ?? 800);

    /// <summary>Called by workbench-shell.js when a resize handle is dragged or moved with the keyboard.</summary>
    [JSInvokable]
    public Task OnViewportResized(int width, int height) => InvokeAsync(async () =>
    {
        if (_scenario is null)
            return;
        await ApplySize(width, height);
        StateHasChanged();
    });

    private Task RotateViewport() => EffectiveViewport is null ? Task.CompletedTask : OnToolsChanged(_tools with { Rotate = !_tools.Rotate });

    private async Task SetTouch(bool on)
    {
        // Back to automatic when the choice matches the preset.
        _touch = on == (ViewportName != CustomViewport && _viewport?.IsMobile == true) && ViewportName != CustomViewport ? null : on;
        await SyncDeviceAsync();
        UpdateAddress();
    }

    /// <summary>Tells the preview about a change of touch emulation; it applies without reloading.</summary>
    private async Task SyncDeviceAsync()
    {
        if (EffectiveTouch == _sentTouch)
            return;
        _sentTouch = EffectiveTouch;
        if (_mode == "canvas")
            await Post("device", new { touch = _sentTouch });
    }

    private async Task FitZoom()
    {
        if (_module is null || EffectiveViewport is not { } v)
            return;
        try
        {
            var zoom = await _module.InvokeAsync<double>("fitZoom", v.Width, v.Height);
            await OnToolsChanged(_tools with { Zoom = Math.Clamp(zoom, 0.1, 1) });
        }
        catch (JSDisconnectedException) { }
    }

    private Task HighlightOverflow() => Post("highlight-overflow", null);

    private async Task OnToolsChanged(PreviewTools tools)
    {
        var previewChanged = !tools.PreviewQuery(null).SequenceEqual(_tools.PreviewQuery(null)) || tools.Background != _tools.Background;
        _tools = tools;
        if (previewChanged)
        {
            // A design overlay needs the preview's layout; the other tools apply instantly.
            var background = BackgroundValue;
            await Post("tools", _tools.ToMessage(background));
        }

        UpdateAddress();
    }

    private async Task OnLayout(string what)
    {
        if (what == "panel")
        {
            _panelRight = !_panelRight;
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("setPreference", "panel-position", _panelRight ? "right" : "bottom"); }
                catch (JSDisconnectedException) { }
            }
        }
        else
        {
            _focusMode = !_focusMode;
        }
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        if (mode == "canvas")
        {
            // The canvas iframe is created again: load the preview with the current state.
            _previewState = "loading";
            _layout = null;
            _frameSrc = BuildPreviewUrl(includeArgs: true);
            _sentTouch = EffectiveTouch;
        }

        UpdateAddress();
    }

    private async Task OnThemeChanged()
    {
        // An explicit choice: the preview no longer follows the Workbench theme.
        _themeFollowsShell = false;
        await SendThemeAsync();
        UpdateAddress();
    }

    private Task SendThemeAsync()
    {
        var theme = Options.FindTheme(ThemeName);
        return Post("theme", new { theme = theme?.Name, colorScheme = theme?.ColorScheme.ToString().ToLowerInvariant(), themeClass = theme?.CssClass, themeStylesheets = theme?.Stylesheets ?? [] });
    }

    private async Task OnCultureChanged()
    {
        // Culture is applied when the session starts, so the preview reloads.
        await ReloadFrame(keepArgs: true);
        UpdateAddress();
    }

    private async Task OnSessionOptionChanged()
    {
        // The user and the network profile are part of the session: the preview reloads with them.
        await ReloadFrame(keepArgs: true);
        UpdateAddress();
    }

    private async Task OnDirectionChanged()
    {
        if (Direction.Length > 0)
            await Post("dir", Direction);
        else
            await ReloadFrame(keepArgs: true);
        UpdateAddress();
    }

    private void SelectTab(string key)
    {
        _tab = key;
        if (key == "environment")
            _ = RequestSession();
        else if (key == "html")
            _ = RequestHtml();
        else if (key == "storage")
            _ = SendStorage(new StorageCommand("get"));
        UpdateAddress();
    }

    private async Task ToggleShellTheme()
    {
        _shellTheme = _shellTheme == "dark" ? "light" : "dark";
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("setPreference", "shell-theme", _shellTheme); }
            catch (JSDisconnectedException) { }
        }

        // Unless a theme was chosen explicitly, the preview switches with the Workbench, without reloading.
        if (_scenario is not null && _themeFollowsShell && ThemeName != ShellMatchedTheme)
        {
            ThemeName = ShellMatchedTheme;
            await SendThemeAsync();
        }
    }

    private void RememberRecent(string id)
    {
        _recent.Remove(id);
        _recent.Insert(0, id);
        if (_recent.Count > 8)
            _recent.RemoveRange(8, _recent.Count - 8);
        if (_module is not null)
            _ = _module.InvokeVoidAsync("setPreference", "recent", string.Join(',', _recent)).AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
    }

    private Task SendGate((string Name, bool Fail) gate) => Post("gate", new { name = gate.Name, action = gate.Fail ? "fail" : "release" });

    private Task AdvanceClock(double milliseconds) => Post("clock", milliseconds);

    private Task RequestSession() => Post("session", null);

    private Task RequestHtml()
    {
        _html = null;
        return Post("html", null);
    }

    private Task SendStorage(StorageCommand command) => Post("storage", new { op = command.Op, area = command.Area, key = command.Key, value = command.Value });

    private Task Highlight((string Selector, string Label) target) => Post("highlight", new { selector = target.Selector, label = target.Label });

    private async Task RunInteraction((string Name, bool Debug) run)
    {
        // Interactions run against a fresh session so results match automated runs.
        _runningInteraction = run.Name;
        _interactionResults.Remove(run.Name);
        _pendingInteraction = run.Name;
        _pendingDebug = run.Debug;
        await ReloadFrame(keepArgs: false);
    }

    private Task ContinueInteraction(string command)
    {
        _paused = null;
        return Post("interaction-continue", command);
    }

    private async Task Record((bool On, bool Assert) record)
    {
        if (record.On && !_recording)
            _recorded.Clear();
        _recording = record.On;
        _assertMode = record.On && record.Assert;
        await Post("record", new { on = record.On, assert = record.Assert });
    }

    private async Task RunAccessibility()
    {
        _a11yRunning = true;
        _a11y = null;
        if (_previewState == "ready")
            await Post("a11y", new { disabledRules = _scenario?.Accessibility.DisabledRules ?? [] });
        else
            _pendingA11y = true;
    }

    private int TabCount(string key) => key switch
    {
        "actions" => _callbacks.Count,
        "diagnostics" => _diagnostics.Count(d => d.Severity >= DiagnosticSeverity.Warning),
        "accessibility" => _a11y?.Violations?.Length ?? 0,
        "controls" => _argErrors.Count,
        "environment" => _gates.Count(g => g.Status == GateStatus.Pending),
        "design" => _scenario?.Designs.Count ?? 0,
        "interactions" => _recorded.Count,
        _ => 0,
    };

    [JSInvokable]
    public Task OnPreviewMessage(string json) => InvokeAsync(async () =>
    {
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        var type = root.GetProperty("type").GetString();
        var scenarioId = root.TryGetProperty("scenarioId", out var sid) ? sid.GetString() : null;
        if (_scenario is null || (scenarioId is { Length: > 0 } && !string.Equals(scenarioId, _scenario.Id, StringComparison.OrdinalIgnoreCase)))
            return;
        var payload = root.TryGetProperty("payload", out var p) ? p : default;

        switch (type)
        {
            case "state":
                _previewState = payload.GetProperty("state").GetString() ?? "loading";
                _metrics = payload.TryGetProperty("metrics", out var m) ? m.Deserialize<PreviewMetrics>(WorkbenchJson.Options) : null;
                if (_previewState is "ready" or "error")
                {
                    // Deep links such as ?panel=environment show the live services and requests without a click on Refresh.
                    if (_tab == "environment")
                        await Post("session", null);
                    else if (_tab == "html")
                        await RequestHtml();
                    else if (_tab == "storage")
                        await SendStorage(new StorageCommand("get"));

                    if (_pendingInteraction is { } pending && _scenario.Interactions.FirstOrDefault(i => i.Name == pending) is { } test)
                    {
                        _pendingInteraction = null;
                        await Post("interaction", new { test = JsonSerializer.SerializeToElement(test, WorkbenchJson.Options), step = _pendingDebug });
                    }

                    if (_pendingA11y)
                    {
                        _pendingA11y = false;
                        await Post("a11y", new { disabledRules = _scenario.Accessibility.DisabledRules });
                    }
                }
                break;
            case "diagnostic":
                if (payload.Deserialize<DiagnosticDto>(WorkbenchJson.Options) is { } diagnostic)
                {
                    _diagnostics.Add(diagnostic);
                    if (_diagnostics.Count > Options.MaxDiagnostics) _diagnostics.RemoveAt(0);
                }
                break;
            case "callback":
                if (payload.Deserialize<CallbackEntry>(WorkbenchJson.Options) is { } entry)
                {
                    _callbacks.Add(entry);
                    _callbackCounts[entry.Name] = entry.Invocation;
                }
                break;
            case "gates":
                _gates = payload.Deserialize<List<GateInfo>>(WorkbenchJson.Options) ?? [];
                break;
            case "arg-errors":
                _argErrors = payload.Deserialize<Dictionary<string, string>>(WorkbenchJson.Options) ?? new();
                break;
            case "args-changed":
                // Two-way bound values changed inside the component (for example typing into an input).
                foreach (var property in payload.EnumerateObject())
                    _overrides[property.Name] = ArgsCodec.FromElement(property.Value);
                UpdateAddress();
                break;
            case "session":
                _session = payload.Clone();
                break;
            case "interaction-progress":
            case "interaction":
                if (payload.Deserialize<InteractionOutcome>(WorkbenchJson.Options) is { } outcome)
                {
                    _interactionResults[outcome.Name] = outcome;
                    if (type == "interaction")
                    {
                        _runningInteraction = null;
                        _paused = null;
                    }
                }
                break;
            case "interaction-paused":
                _paused = (payload.GetProperty("name").GetString() ?? "", payload.GetProperty("index").GetInt32());
                break;
            case "recorded-step":
                if (_recording && payload.Deserialize<InteractionStep>(WorkbenchJson.Options) is { } step)
                    _recorded.Add(step);
                break;
            case "html":
                _html = payload.TryGetProperty("html", out var html) ? html.GetString() ?? "" : "";
                break;
            case "storage":
                _storage = payload.Deserialize<StorageSnapshot>(WorkbenchJson.Options);
                break;
            case "a11y":
                _a11y = payload.Deserialize<A11yOutcome>(WorkbenchJson.Options);
                _a11yRunning = false;
                break;
            case "layout":
                _layout = payload.Deserialize<LayoutReport>(WorkbenchJson.Options);
                break;
            case "breakpoints":
                var detected = payload.Deserialize<List<DetectedBreakpoint>>(WorkbenchJson.Options) ?? [];
                if (detected.SequenceEqual(_detected))
                    return;
                _detected = detected;
                _marks = ResponsiveLayout.Merge(Options.Breakpoints, _detected);
                break;
        }

        StateHasChanged();
    });

    private void OnCatalogChanged() => _ = InvokeAsync(async () =>
    {
        // Hot reload: re-resolve the scenario and reload the preview.
        _loadedScenarioId = null;
        _marks = ResponsiveLayout.Merge(Options.Breakpoints, _detected);
        OnParametersSet();
        StateHasChanged();
        if (_scenario is not null)
            await ReloadFrame(keepArgs: true);
    });

    public async ValueTask DisposeAsync()
    {
        Catalogs.Changed -= OnCatalogChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }

        _self?.Dispose();
    }
}

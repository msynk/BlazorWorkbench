    private bool IsPinned =>_scenario is not null && _pinned.Contains(_scenario.Id, StringComparer.OrdinalIgnoreCase);

    /// <summary>Pins or unpins the current scenario (like bookmarks in other workbenches); pins are kept in this browser.</summary>
    private async Task TogglePin()
    {
        if (_scenario is null)
            return;
        var id = _scenario.Id;
        if (_pinned.RemoveAll(p => string.Equals(p, id, StringComparison.OrdinalIgnoreCase)) == 0)
            _pinned.Add(id);
        // A new list, so the explorer sees a changed parameter.
        _pinned = [.. _pinned];

        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("setPreference", "pinned", string.Join(',', _pinned)); }
            catch (JSDisconnectedException) { }
        }
    }

    private void RememberRecent(string id)
    {
        _recent.Remove(id);
        _recent.Insert(0, id);
        if (_recent.Count > 8)
            _recent.RemoveRange(8, _recent.Count - 8);
        if (_module is not null)
            _ = _module.InvokeVoidAsync("setPreference", "recent", string.Join(',', _recent)).AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
    }

    private Task SendGate((string Name, bool Fail) gate) => Post("gate", new { name = gate.Name, action = gate.Fail ? "fail" : "release" });

    private Task AdvanceClock(double milliseconds) => Post("clock", milliseconds);

    private Task RequestSession() => Post("session", null);

    private Task RequestHtml()
    {
        _html = null;
        return Post("html", null);
    }

    private Task SendStorage(StorageCommand command) => Post("storage", new { op = command.Op, area = command.Area, key = command.Key, value = command.Value });

    private Task RequestOutline() => Post("outline", null);

    private Task HighlightOutline((int Index, string Label) target) => Post("highlight", new { outline = target.Index, label = target.Label });

    private Task Highlight((string Selector, string Label) target) => Post("highlight", new { selector = target.Selector, label = target.Label });

    private async Task RunInteraction((string Name, bool Debug) run)
    {
        if (_mode != "canvas")
            SetMode("canvas");
        // Interactions run against a fresh session with the scenario's declared state, so results match automated runs:
        // the controls go back to the declared values too, so what the panel shows is what the test runs on.
        _overrides = new(StringComparer.Ordinal);
        _argErrors = new(StringComparer.Ordinal);
        _runningInteraction = run.Name;
        _interactionResults.Remove(run.Name);
        _pendingInteraction = run.Name;
        _pendingDebug = run.Debug;
        await ReloadFrame(keepArgs: false);
        UpdateAddress();
    }

    private Task ContinueInteraction(string command)
    {
        _paused = null;
        return Post("interaction-continue", command);
    }

    private async Task Record((bool On, bool Assert) record)
    {
        if (record.On && !_recording)
            _recorded.Clear();
        _recording = record.On;
        _assertMode = record.On && record.Assert;
        await Post("record", new { on = record.On, assert = record.Assert });
    }

    private async Task RunAccessibility()
    {
        if (_mode != "canvas")
            SetMode("canvas");
        _a11yRunning = true;
        _a11y = null;
        // A preview in the error state never becomes ready: scan what it shows (the error panel) rather than wait.
        if (_previewState is "ready" or "error")
        {
            if (!await Post("a11y", new { disabledRules = _scenario?.Accessibility.DisabledRules ?? [] }))
                _pendingA11y = true;
        }
        else
        {
            _pendingA11y = true;
        }
    }

    private int TabCount(string key) => key switch
    {
        "actions" => _callbacks.Count,
        "diagnostics" => _diagnostics.Count(d => d.Severity >= DiagnosticSeverity.Warning),
        "accessibility" => _a11y?.Violations?.Length ?? 0,
        "controls" => _argErrors.Count,
        "environment" => _gates.Count(g => g.Status == GateStatus.Pending),
        "design" => _scenario?.Designs.Count ?? 0,
        "interactions" => _recorded.Count,
        _ => 0,
    };

    [JSInvokable]
    public Task OnPreviewMessage(string json) => InvokeAsync(async () =>
    {
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        var type = root.GetProperty("type").GetString();
        var scenarioId = root.TryGetProperty("scenarioId", out var sid) ? sid.GetString() : null;
        if (_scenario is null || (scenarioId is { Length: > 0 } && !string.Equals(scenarioId, _scenario.Id, StringComparison.OrdinalIgnoreCase)))
            return;
        var payload = root.TryGetProperty("payload", out var p) ? p : default;

        switch (type)
        {
            case "state":
                var wasReady = _previewState == "ready";
                _previewState = payload.GetProperty("state").GetString() ?? "loading";
                if (_previewState == "ready" && !wasReady)
                    _previewVersion++;
                _metrics = payload.TryGetProperty("metrics", out var m) ? m.Deserialize<PreviewMetrics>(WorkbenchJson.Options) : null;
                if (_previewState is "ready" or "error")
                {
                    // Deep links such as ?panel=environment show the live services and requests without a click on Refresh.
                    if (_tab == "environment")
                        await Post("session", null);
                    else if (_tab == "html")
                        await RequestHtml();
                    else if (_tab == "storage")
                        await SendStorage(new StorageCommand("get"));
                    else if (_tab == "accessibility")
                        await RequestOutline();

                    if (_pendingInteraction is { } pending && _scenario.Interactions.FirstOrDefault(i => i.Name == pending) is { } test)
                    {
                        _pendingInteraction = null;
                        await Post("interaction", new { test = JsonSerializer.SerializeToElement(test, WorkbenchJson.Options), step = _pendingDebug });
                    }

                    if (_pendingA11y)
                    {
                        _pendingA11y = false;
                        await Post("a11y", new { disabledRules = _scenario.Accessibility.DisabledRules });
                    }
                }
                break;
            case "diagnostic":
                if (payload.Deserialize<DiagnosticDto>(WorkbenchJson.Options) is { } diagnostic)
                {
                    _diagnostics.Add(diagnostic);
                    if (_diagnostics.Count > Options.MaxDiagnostics) _diagnostics.RemoveAt(0);
                }
                break;
            case "callback":
                if (payload.Deserialize<CallbackEntry>(WorkbenchJson.Options) is { } entry)
                {
                    _callbacks.Add(entry);
                    // Bounded like the diagnostics: a component raising a callback on a timer must not grow the circuit.
                    if (_callbacks.Count > Options.MaxDiagnostics) _callbacks.RemoveAt(0);
                    _callbackCounts[entry.Name] = entry.Invocation;
                }
                break;
            case "gates":
                _gates = payload.Deserialize<List<GateInfo>>(WorkbenchJson.Options) ?? [];
                break;
            case "js-call":
                // The Environment panel lists the calls from the session; refresh it at most a few times per second.
                if (_tab == "environment" && !_sessionRefreshQueued)
                {
                    _sessionRefreshQueued = true;
                    _ = RefreshSessionSoonAsync();
                }

                return;
            case "arg-errors":
                _argErrors = payload.Deserialize<Dictionary<string, string>>(WorkbenchJson.Options) ?? new();
                break;
            case "args-changed":
                // Two-way bound values changed inside the component (for example typing into an input).
                foreach (var property in payload.EnumerateObject())
                    _overrides[property.Name] = ArgsCodec.FromElement(property.Value);
                UpdateAddress();
                break;
            case "session":
                _session = payload.Clone();
                break;
            case "interaction-progress":
            case "interaction":
                if (payload.Deserialize<InteractionOutcome>(WorkbenchJson.Options) is { } outcome)
                {
                    _interactionResults[outcome.Name] = outcome;
                    if (type == "interaction")
                    {
                        _runningInteraction = null;
                        _paused = null;
                    }
                }
                break;
            case "interaction-paused":
                _paused = (payload.GetProperty("name").GetString() ?? "", payload.GetProperty("index").GetInt32());
                break;
            case "recorded-step":
                if (_recording && payload.Deserialize<InteractionStep>(WorkbenchJson.Options) is { } step)
                    _recorded.Add(step);
                break;
            case "html":
                _html = payload.TryGetProperty("html", out var html) ? html.GetString() ?? "" : "";
                break;
            case "storage":
                _storage = payload.Deserialize<StorageSnapshot>(WorkbenchJson.Options);
                break;
            case "outline":
                _outline = payload.Deserialize<OutlineReport>(WorkbenchJson.Options);
                break;
            case "evaluate-result":
                if (payload.TryGetProperty("id", out var evaluationId) && _evaluations.Remove(evaluationId.GetInt32(), out var evaluation))
                {
                    if (payload.TryGetProperty("ok", out var ok) && ok.GetBoolean())
                        evaluation.TrySetResult(payload.TryGetProperty("value", out var value) ? value.Clone() : default);
                    else
                        evaluation.TrySetException(new InvalidOperationException("The script failed in the preview: " +
                            (payload.TryGetProperty("error", out var evaluationError) ? evaluationError.GetString() : "unknown error")));
                }

                return;
            case "a11y":
                _a11y = payload.Deserialize<A11yOutcome>(WorkbenchJson.Options);
                _a11yRunning = false;
                break;
            case "layout":
                _layout = payload.Deserialize<LayoutReport>(WorkbenchJson.Options);
                break;
            case "breakpoints":
                var detected = payload.Deserialize<List<DetectedBreakpoint>>(WorkbenchJson.Options) ?? [];
                if (detected.SequenceEqual(_detected))
                    return;
                _detected = detected;
                _marks = ResponsiveLayout.Merge(Options.Breakpoints, _detected);
                break;
        }

        StateHasChanged();
    });

    // ---- Test runner (sidebar) ----

    /// <summary>Runs the request's scenarios in invisible frames: render health (and accessibility) once, each interaction in a fresh session.</summary>
    private async Task RunTests(UiTestRequest request)
    {
        if (_module is null)
            return;
        var jobs = new List<object>();
        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var skipped = new List<ScenarioDefinition>();
        foreach (var id in request.ScenarioIds)
        {
            if (Catalog.FindScenario(id) is not { } scenario)
                continue;
            if (scenario.SkipReason is not null)
            {
                skipped.Add(scenario);
                continue;
            }

            var viewport = Options.FindViewport(scenario.Environment.Viewport);
            var url = $"_workbench/preview/{Uri.EscapeDataString(scenario.Id)}" + (viewport?.IsMobile == true ? "?touch=1" : "");
            var size = new { width = viewport?.Width ?? 1280, height = viewport?.Height ?? 800 };
            var a11y = request.Accessibility && !scenario.Accessibility.Skip
                ? new { disabledRules = scenario.Accessibility.DisabledRules, failOn = "serious", todo = scenario.Accessibility.TodoReason }
                : null;
            jobs.Add(new { scenarioId = scenario.Id, kind = "render", url, size.width, size.height, timeout = 20000, a11y });
            foreach (var test in scenario.Interactions)
                jobs.Add(new { scenarioId = scenario.Id, kind = "interaction", name = test.Name, url, size.width, size.height, timeout = 20000, test = JsonSerializer.SerializeToElement(test, WorkbenchJson.Options) });
            counts[scenario.Id] = 1 + scenario.Interactions.Count;
        }

        _uiRun.Start(request, counts);
        foreach (var scenario in skipped)
            _uiRun.Skip(scenario.Id, scenario.SkipReason!);
        if (jobs.Count == 0)
        {
            _uiRun.Finish();
            return;
        }

        try { await _module.InvokeVoidAsync("startTests", jobs, _self, new { concurrency = 2, runId = ++_runId }); }
        catch (JSDisconnectedException) { }
    }

    // Identifies the current UI test run; callbacks of a canceled run carry an older id and are ignored.
    private int _runId;

    private async Task StopTests()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("cancelTests"); }
            catch (JSDisconnectedException) { }
        }

        _uiRun.Finish();
    }

    [JSInvokable]
    public Task OnTestResult(string json) => InvokeAsync(() =>
    {
        if (!_uiRun.Running || JsonSerializer.Deserialize<UiTestResult>(json, WorkbenchJson.Options) is not { } result || result.Status == "canceled" || result.RunId != _runId)
            return;
        _uiRun.Add(result);
        if (_scenario is not null && string.Equals(result.ScenarioId, _scenario.Id, StringComparison.OrdinalIgnoreCase))
            ShowRunResult(result);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnTestsFinished(bool completed, int runId) => InvokeAsync(() =>
    {
        if (runId != _runId)
            return;
        if (_uiRun.Running)
            _uiRun.Finish();
        StateHasChanged();
    });

    /// <summary>Shows a result of the UI run in the Interactions or Accessibility panel of the scenario on screen.</summary>
    private void ShowRunResult(UiTestResult result)
    {
        if (result.Details is not { } details)
            return;
        try
        {
            if (result.Kind == "interaction" && details.Deserialize<InteractionOutcome>(WorkbenchJson.Options) is { } outcome)
                _interactionResults[outcome.Name] = outcome;
            else if (result.Kind == "render" && details.ValueKind == JsonValueKind.Object && details.TryGetProperty("violations", out _))
                _a11y = details.Deserialize<A11yOutcome>(WorkbenchJson.Options);
        }
        catch (JsonException)
        {
            // Details are informational; a malformed one leaves the panels as they are.
        }
    }

    private void OnCatalogChanged() => _ = InvokeAsync(async () =>
    {
        // Hot reload: re-resolve the scenario and reload the preview.
        _loadedScenarioId = null;
        _marks = ResponsiveLayout.Merge(Options.Breakpoints, _detected);
        OnParametersSet();
        StateHasChanged();
        if (_scenario is not null)
            await ReloadFrame(keepArgs: true);
        // Watch mode: the components changed, so run the last tests again.
        if (_uiRun.Watch && _uiRun.Request is { } request)
        {
            if (_uiRun.Running)
                await StopTests();
            await RunTests(request with { ScenarioIds = request.ScenarioIds.Where(id => Catalog.FindScenario(id) is not null).ToList() });
            StateHasChanged();
        }
    });

    private readonly CancellationTokenSource _disposed = new();

    private async Task RefreshSessionSoonAsync()
    {
        try
        {
            await Task.Delay(300, _disposed.Token);
            await InvokeAsync(async () =>
            {
                _sessionRefreshQueued = false;
                await RequestSession();
            });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // The shell went away meanwhile.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.IsCancellationRequested)
            await _disposed.CancelAsync();
        Catalogs.Changed -= OnCatalogChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }

        _self?.Dispose();
    }

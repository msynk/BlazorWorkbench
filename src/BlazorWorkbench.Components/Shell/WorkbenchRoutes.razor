@* Router for the Workbench pages. Lives in the RCL so both Interactive Server and WebAssembly hosts can render it.
   FocusOnNavigate is intentionally omitted: moving focus would interfere with focus behavior under test in previews. *@
<CascadingValue Name="WorkbenchServerBaseUri" Value="ServerBaseUri" IsFixed="true">
<Router AppAssembly="typeof(WorkbenchShell).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <main class="wb-not-found" role="alert">
            <h1>This Workbench page does not exist</h1>
            <p>Scenarios are at <code>scenario/{id}</code>, documentation at <code>docs/{component}</code> and pages at <code>pages/{id}</code>.</p>
            <p><a href="">Go to the overview</a></p>
        </main>
    </NotFound>
</Router>
</CascadingValue>

@code {
    /// <summary>
    /// The host's own address for server-side requests (relative catalog references), set by the host page. Null in hosts
    /// without one (WebAssembly fetches from the browser, where the page's address is the right base).
    /// </summary>
    [Parameter] public string? ServerBaseUri { get; set; }
}

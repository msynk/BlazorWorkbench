<div class="wb-a11y">
    <div class="wb-inspector-actions">
        <span class="wb-muted wb-small">
            Automated checks (axe-core) find a subset of WCAG issues. Passing them does not mean the component is accessible;
            verify keyboard use, screen reader output and zoom manually.
        </span>
        <button type="button" class="wb-button" @onclick="() => OnRun.InvokeAsync()" disabled="@Running">@(Running ? "Scanning…" : "Run scan")</button>
    </div>
    <p class="wb-muted wb-small">Tip: the canvas toolbar's <strong>Accessibility</strong> menu simulates color vision deficiencies, larger text and text spacing, and shows the tab order.</p>
    @if (Scenario.Accessibility.Skip)
    {
        <p class="wb-muted">Automated runs skip this scenario: @Scenario.Accessibility.SkipReason</p>
    }
    @if (Scenario.Accessibility.DisabledRules.Count > 0)
    {
        <p class="wb-muted">Disabled rules: @string.Join(", ", Scenario.Accessibility.DisabledRules) — @Scenario.Accessibility.Justification</p>
    }
    @if (Result?.Error is { } error)
    {
        <p class="wb-error" role="alert">@error</p>
    }
    else if (Result is not null)
    {
        <p role="status">
            <strong>@(Result.Violations?.Length ?? 0)</strong> violation(s), @(Result.Incomplete?.Length ?? 0) need review, @Result.Passes rule(s) passed
            <span class="wb-muted">(@Result.Engine)</span>
        </p>
        @RenderRules("Violations", Result.Violations)
        @RenderRules("Needs manual review", Result.Incomplete)
    }

    <section class="wb-outline" aria-labelledby="wb-outline-title">
        <header class="wb-code-header">
            <h2 class="wb-h3" id="wb-outline-title">Outline</h2>
            <button type="button" class="wb-button wb-button-small" @onclick="() => OnRefreshOutline.InvokeAsync()">Refresh</button>
        </header>
        <p class="wb-muted wb-small">The headings and landmarks a screen reader lists, in document order. Headings should not skip levels; landmarks of the same kind need distinct names.</p>
        @if (Outline is null)
        {
            <p class="wb-muted">Reading the outline…</p>
        }
        else
        {
            <div class="wb-outline-columns">
                <div>
                    <h3 class="wb-h4">Headings <span class="wb-muted wb-small">@Outline.Headings.Length</span></h3>
                    @if (Outline.Headings.Length == 0)
                    {
                        <p class="wb-muted wb-small">No headings. Fine for small components; pages and dialogs usually need one.</p>
                    }
                    else
                    {
                        <ul class="wb-outline-list">
                            @foreach (var h in Outline.Headings)
                            {
                                <li style="@Indent(h.Level - 1)" class="@(h.Issue is null ? "" : "wb-outline-issue")">
                                    <button type="button" class="wb-link-button" @onclick='() => OnHighlightOutline.InvokeAsync((h.Index, "h" + h.Level))' title="Outline the heading in the preview">
                                        <span class="wb-badge">h@(h.Level)</span> @(h.Text.Length > 0 ? h.Text : "(empty)")
                                    </button>
                                    @if (h.Issue is { } issue) { <span class="wb-outline-note" role="note">@issue</span> }
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div>
                    <h3 class="wb-h4">Landmarks <span class="wb-muted wb-small">@Outline.Landmarks.Length</span></h3>
                    @if (Outline.Landmarks.Length == 0)
                    {
                        <p class="wb-muted wb-small">No landmarks. Expected for most components; page layouts need banner, main and contentinfo.</p>
                    }
                    else
                    {
                        <ul class="wb-outline-list">
                            @foreach (var l in Outline.Landmarks)
                            {
                                <li style="@Indent(l.Depth)" class="@(l.Issue is null ? "" : "wb-outline-issue")">
                                    <button type="button" class="wb-link-button" @onclick="() => OnHighlightOutline.InvokeAsync((l.Index, l.Role))" title="Outline the landmark in the preview">
                                        <span class="wb-badge">@l.Role</span> @(l.Name.Length > 0 ? l.Name : "(no name)")
                                    </button>
                                    @if (l.Issue is { } issue) { <span class="wb-outline-note" role="note">@issue</span> }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public A11yOutcome? Result { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter, EditorRequired] public ScenarioDefinition Scenario { get; set; } = default!;
    [Parameter] public EventCallback OnRun { get; set; }

    /// <summary>Outlines an element in the preview: the axe-core selector and a label.</summary>
    [Parameter] public EventCallback<(string Selector, string Label)> OnHighlight { get; set; }

    /// <summary>The preview's headings and landmarks; null until the preview has reported them.</summary>
    [Parameter] public OutlineReport? Outline { get; set; }

    [Parameter] public EventCallback OnRefreshOutline { get; set; }

    /// <summary>Outlines a heading or landmark of <see cref="Outline"/> in the preview: its index and a label.</summary>
    [Parameter] public EventCallback<(int Index, string Label)> OnHighlightOutline { get; set; }

    private static string Indent(int steps) => string.Create(CultureInfo.InvariantCulture, $"padding-inline-start: {steps * 0.9:0.#}rem");

    private static int ImpactOrder(string? impact) => impact switch { "critical" => 0, "serious" => 1, "moderate" => 2, "minor" => 3, _ => 4 };

    private RenderFragment RenderRules(string title, A11yRule[]? rules) => __builder =>
    {
        if (rules is not { Length: > 0 })
            return;
        <h2 class="wb-h3">@title</h2>
        @foreach (var rule in rules.OrderBy(r => ImpactOrder(r.Impact)))
        {
            <details class="wb-a11y-rule wb-impact-@(rule.Impact ?? "none")">
                <summary><span class="wb-badge">@(rule.Impact ?? "n/a")</span> <strong>@rule.Help</strong> <code>@rule.Id</code> — @(rule.Nodes?.Length ?? 0) element(s)</summary>
                <p>@rule.Description</p>
                @if (rule.HelpUrl is { } url && SafeMarkdown.IsSafeUrl(url))
                {
                    <p><a href="@url" target="_blank" rel="noopener noreferrer">How to fix</a></p>
                }
                @if (rule.Tags is { Length: > 0 })
                {
                    <p class="wb-muted wb-small">@string.Join(", ", rule.Tags)</p>
                }
                <ul>
                    @foreach (var node in rule.Nodes ?? [])
                    {
                        <li>
                            <code>@node.Target</code>
                            @if (OnHighlight.HasDelegate)
                            {
                                <button type="button" class="wb-button wb-button-small" @onclick="() => OnHighlight.InvokeAsync((node.Target, rule.Id))" title="Outline the element in the preview">Highlight</button>
                            }
                            <pre>@node.Html</pre>
                            @if (node.FailureSummary is { } summary)
                            {
                                <div class="wb-muted wb-small">@summary</div>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
    };
}

@inject NavigationManager Navigation
@inject IServiceProvider Services

<div class="wb-explorer">
    <div class="wb-search">
        <label for="wb-search" class="wb-visually-hidden">Search components and scenarios</label>
        <input id="wb-search" type="search" placeholder="Search ( / )" autocomplete="off"
               @bind="Query" @bind:event="oninput" @onkeydown="OnSearchKey" aria-describedby="wb-search-hint" />
        <span id="wb-search-hint" class="wb-visually-hidden">
            Matches component names, titles, tags, parameters, scenario names and pages. Filters: tag:name, status:beta, is:matrix,
            is:generated, is:tested, is:skipped, is:deprecated, is:documented, is:failing, is:passing, is:flaky, is:pinned, is:changed, is:new, is:related, is:affected.
            Start a filter with a minus sign to exclude, for example -tag:legacy. Press Enter to open the first result.
        </span>
        <div class="wb-quick-filters" role="group" aria-label="Quick filters">
            @foreach (var (token, label) in QuickFilters)
            {
                var on = _query.Split(' ').Contains(token);
                <button type="button" class="wb-chip @(on ? "active" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleFilter(token)">@label</button>
            }
        </div>
    </div>

    @if (_matches is not null)
    {
        var total = _matches.Count + _pageMatches.Count + _refMatches.Count;
        <p class="wb-muted wb-small" role="status">@total result@(total == 1 ? "" : "s")@(_matches.Count > MaxResults ? $", showing the first {MaxResults} scenarios; refine the search to see the rest" : "")</p>
        <ul class="wb-results">
            @foreach (var docPage in _pageMatches)
            {
                <li>
                    <a href="@($"pages/{docPage.Id}")" class="@(docPage.Id == SelectedPageId ? "active" : "")">
                        <span class="wb-result-component">Page</span>
                        <span>@docPage.Title</span>
                    </a>
                </li>
            }
            @foreach (var (reference, component) in _refMatches.Take(MaxResults))
            {
                <li>
                    <a href="@RefHref(reference, component)" class="@(IsSelectedRef(reference, component) ? "active" : "")">
                        <span class="wb-result-component">@reference.Reference.Title</span>
                        <span>@component.Title</span>
                    </a>
                </li>
            }
            @foreach (var (component, scenario) in _matches.Take(MaxResults))
            {
                <li>
                    <a href="@($"scenario/{scenario.Id}")" class="@(scenario.Id == SelectedScenarioId ? "active" : "")" aria-current="@(scenario.Id == SelectedScenarioId ? "page" : null)">
                        <span class="wb-result-component">@component.Title @if (component.Status is { } status) { <StatusBadge Status="status" Compact="true" /> }</span>
                        <span>@scenario.Name @RunDot(scenario.Id) @ChangeMark(scenario.Id)</span>
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="wb-tree-actions" role="group" aria-label="Explorer tree">
            <button type="button" class="wb-button wb-button-small" @onclick="() => SetAllExpanded(true)" title="Open every group (components stay closed)">Expand all</button>
            <button type="button" class="wb-button wb-button-small" @onclick="() => SetAllExpanded(false)" title="Close every group and component">Collapse all</button>
        </div>
        <nav aria-label="Components">
            @if (PinnedScenarios.Count > 0)
            {
                <details class="wb-recent wb-pinned" open="@_pinnedOpen">
                    <summary class="wb-node-group" @onclick="() => _pinnedOpen = !_pinnedOpen" @onclick:preventDefault>Pinned <span class="wb-muted wb-small">@PinnedScenarios.Count</span></summary>
                    <ul class="wb-tree wb-recent-list">
                        @foreach (var (component, scenario) in PinnedScenarios)
                        {
                            <li><a href="@($"scenario/{scenario.Id}")" class="@(scenario.Id == SelectedScenarioId ? "active" : "")"><span class="wb-pin-mark" aria-hidden="true">★</span><span class="wb-muted">@component.DisplayName ·</span> @scenario.Name @RunDot(scenario.Id)</a></li>
                        }
                    </ul>
                </details>
            }
            @if (RecentScenarios.Count > 0)
            {
                <details class="wb-recent" open="@_recentOpen">
                    <summary class="wb-node-group" @onclick="() => _recentOpen = !_recentOpen" @onclick:preventDefault>Recent</summary>
                    <ul class="wb-tree wb-recent-list">
                        @foreach (var (component, scenario) in RecentScenarios)
                        {
                            <li><a href="@($"scenario/{scenario.Id}")" class="@(scenario.Id == SelectedScenarioId ? "active" : "")"><span class="wb-muted">@component.DisplayName ·</span> @scenario.Name</a></li>
                        }
                    </ul>
                </details>
            }
            @RenderGroup(_tree, 0)
            @foreach (var reference in _references)
            {
                var refOpen = IsExpanded("ref:" + reference.Reference.Id, SelectedRefId == reference.Reference.Id);
                <details class="wb-ref" open="@refOpen">
                    <summary class="wb-node-group" @onclick='() => Flip("ref:" + reference.Reference.Id, refOpen)' @onclick:preventDefault
                             title="@($"Published catalog: {reference.Reference.Url}")">
                        <span class="wb-icon" aria-hidden="true">⧉</span>@reference.Reference.Title <span class="wb-muted wb-small">@reference.Components.Count</span>
                    </summary>
                    @if (refOpen)
                    {
                        @if (reference.Error is { } refError)
                        {
                            <p class="wb-muted wb-small wb-ref-error" role="note">@refError</p>
                        }
                        <ul class="wb-tree">
                            @foreach (var component in reference.Components)
                            {
                                <li><a href="@RefHref(reference, component)" class="@(IsSelectedRef(reference, component) ? "active" : "")"
                                       aria-current="@(IsSelectedRef(reference, component) ? "page" : null)">@component.Title.Replace("/", " / ")</a></li>
                            }
                        </ul>
                    }
                </details>
            }
        </nav>
    }

    @if (UiRun is not null)
    {
        <TestRunnerBar Catalog="Catalog" Run="UiRun" Component="SelectedComponent" LastRun="_run" Changes="_changes" OnRun="OnRunTests" OnStop="OnStopTests" />
    }

    <div class="wb-explorer-footer">
        <a href="">Overview</a>
        <a href="tokens">Tokens</a>
        <span class="wb-muted">@Catalog.Components.Count components · @Catalog.Scenarios.Count scenarios</span>
        @if (_run.FinishedAt is { } finished)
        {
            var failing = _run.Scenarios.Values.Count(r => r.Status is "Failed" or "Error");
            <button type="button" class="wb-chip @(failing > 0 ? "wb-chip-failed" : "")" title="@($"Last workbench test run: {ViewerTimeZone.Convert(Services, finished):g}")" @onclick='() => ToggleFilter(failing > 0 ? "is:failing" : "is:passing")'>
                Last run: @(failing > 0 ? $"{failing} failing" : "all passed")
            </button>
            @if (failing > 0)
            {
                <a href="review" class="wb-chip wb-chip-link-review" id="wb-review-link" title="Step through the failed scenarios of the last run and approve screenshot changes">Review</a>
            }
        }
        @if (_changes.Scenarios.Count > 0)
        {
            <button type="button" class="wb-chip wb-chip-changed" title="@($"{_changes.Description}: {string.Join(", ", _changes.Files.Take(8))}{(_changes.Files.Count > 8 ? ", …" : "")}")" @onclick='() => ToggleFilter("is:affected")'>
                @ChangedDirectly changed@(_changes.Scenarios.Count > ChangedDirectly ? $" · {_changes.Scenarios.Count - ChangedDirectly} related" : "")
            </button>
        }
        @if (_errors > 0)
        {
            <a href="" class="wb-count wb-count-error" title="Catalog errors">@_errors</a>
        }
    </div>
</div>

@code {
    [CascadingParameter(Name = "WorkbenchServerBaseUri")] private string? ServerBaseUri { get; set; }

    // Server-side fetches use the address the host page captured; in the browser (WebAssembly) the page address is right.
    private Uri ReferenceBase => !OperatingSystem.IsBrowser() && ServerBaseUri is { Length: > 0 } server ? new Uri(server) : new Uri(Navigation.BaseUri);

    private static readonly (string Token, string Label)[] QuickFilters =
        [("is:pinned", "Pinned"), ("is:affected", "Changed"), ("is:tested", "Has tests"), ("is:failing", "Failing"), ("is:matrix", "Matrix"), ("status:beta", "Beta"), ("status:experimental", "Experimental"), ("is:deprecated", "Deprecated")];

    /// <summary>Search results rendered at once; the status line says when there are more.</summary>
    private const int MaxResults = 200;

    private TestRunSummary _run = TestRunSummary.Empty;

    private Node _tree = new("", "");
    private readonly Dictionary<string, bool> _expanded = new(StringComparer.Ordinal);
    private bool _large;
    private bool _recentOpen = true;
    private bool _pinnedOpen = true;
    private List<(ComponentEntry Component, ScenarioDefinition Scenario)>? _matches;
    private List<DocumentationPage> _pageMatches = [];
    private string _query = "";
    private int _errors;
    private WorkbenchCatalog? _built;

    [Parameter, EditorRequired] public WorkbenchCatalog Catalog { get; set; } = default!;
    [Parameter] public string? SelectedScenarioId { get; set; }
    [Parameter] public string? SelectedComponentId { get; set; }
    [Parameter] public string? SelectedPageId { get; set; }

    /// <summary>The referenced catalog and component on screen (<c>refs/{id}/{component}</c>).</summary>
    [Parameter] public string? SelectedRefId { get; set; }

    [Parameter] public string? SelectedRefComponentId { get; set; }

    private IReadOnlyList<ReferencedCatalog> _references = [];
    private List<(ReferencedCatalog Reference, ReferencedComponent Component)> _refMatches = [];

    private static string RefHref(ReferencedCatalog reference, ReferencedComponent component) =>
        $"refs/{Uri.EscapeDataString(reference.Reference.Id)}/{Uri.EscapeDataString(component.Id)}";

    private bool IsSelectedRef(ReferencedCatalog reference, ReferencedComponent component) =>
        SelectedRefId == reference.Reference.Id && SelectedRefComponentId == component.Id;

    private async Task LoadReferencesAsync()
    {
        if (Catalog.Options.CatalogReferences.Count == 0 || Services.GetService(typeof(CatalogReferenceLoader)) is not CatalogReferenceLoader loader)
            return;
        _references = await loader.LoadAllAsync(Catalog.Options, ReferenceBase);
        if (_query.Length > 0)
            Refresh();
    }

    /// <summary>Recently opened scenario ids, most recent first.</summary>
    [Parameter] public IReadOnlyList<string> Recent { get; set; } = [];

    /// <summary>The test run started from the UI, if the shell offers one; its results take precedence over the last CLI run.</summary>
    [Parameter] public UiTestRun? UiRun { get; set; }

    [Parameter] public EventCallback<UiTestRequest> OnRunTests { get; set; }
    [Parameter] public EventCallback OnStopTests { get; set; }

    private ComponentEntry? SelectedComponent =>
        SelectedScenarioId is not null && Catalog.FindScenario(SelectedScenarioId) is { } selected ? Catalog.GetComponentOf(selected)
        : SelectedComponentId is not null ? Catalog.FindComponent(SelectedComponentId) : null;

    /// <summary>The status of a scenario: from this session's UI run when it has one, else from the last CLI run.</summary>
    private bool TryGetRun(string scenarioId, out ScenarioRunStatus status)
    {
        if (UiRun is not null && UiRun.Summary.Scenarios.TryGetValue(scenarioId, out status!))
            return true;
        return _run.Scenarios.TryGetValue(scenarioId, out status!);
    }

    /// <summary>Scenario ids pinned by the user, in the order they were pinned.</summary>
    [Parameter] public IReadOnlyList<string> Pinned { get; set; } = [];

    private List<(ComponentEntry Component, ScenarioDefinition Scenario)> PinnedScenarios =>
        Pinned.Select(id => Catalog.FindScenario(id)).OfType<ScenarioDefinition>()
            .Select(s => (Catalog.GetComponentOf(s)!, s)).Where(x => x.Item1 is not null).ToList();

    private List<(ComponentEntry Component, ScenarioDefinition Scenario)> RecentScenarios =>
        Recent.Where(id => id != SelectedScenarioId).Select(id => Catalog.FindScenario(id)).OfType<ScenarioDefinition>()
            .Select(s => (Catalog.GetComponentOf(s)!, s)).Where(x => x.Item1 is not null).Take(5).ToList();

    private string Query
    {
        get => _query;
        set
        {
            _query = value;
            Refresh();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReferencesAsync();
        await LoadChangesAsync();
        if (Services.GetService(typeof(ITestResultsProvider)) is ITestResultsProvider provider)
        {
            try { _run = await provider.GetSummaryAsync(); }
            catch (Exception ex) when (ex is IOException or InvalidOperationException or HttpRequestException) { _run = TestRunSummary.Empty; }
        }
    }

    private CatalogChangeSummary _changes = CatalogChangeSummary.Empty;
    private bool _changesLoaded;

    private async Task LoadChangesAsync()
    {
        if (Services.GetService(typeof(IChangesProvider)) is not IChangesProvider provider)
            return;
        try { _changes = await provider.GetChangesAsync(); }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or HttpRequestException) { _changes = CatalogChangeSummary.Empty; }
        if (_query.Length > 0)
            Refresh();
    }

    private int ChangedDirectly => _changes.Scenarios.Count(c => c.Value != ScenarioChangeKind.Related);

    /// <summary>A small mark for a scenario affected by the working copy's changes.</summary>
    private RenderFragment ChangeMark(string scenarioId) => __builder =>
    {
        if (_changes.Scenarios.TryGetValue(scenarioId, out var kind))
        {
            var (letter, text) = kind switch
            {
                ScenarioChangeKind.New => ("N", "New since the last commit"),
                ScenarioChangeKind.Modified => ("M", "Changed since the last commit"),
                _ => ("R", "Renders a changed component"),
            };
            <span class="wb-change wb-change-@kind.ToString().ToLowerInvariant()" title="@text"><span aria-hidden="true">@letter</span><span class="wb-visually-hidden">@text</span></span>
        }
    };

    /// <summary>The strongest change among a component's scenarios.</summary>
    private ScenarioChangeKind? ComponentChange(ComponentEntry component)
    {
        ScenarioChangeKind? strongest = null;
        foreach (var scenario in component.Scenarios)
        {
            if (_changes.Scenarios.TryGetValue(scenario.Id, out var kind) && (strongest is null || kind < strongest))
                strongest = kind;
        }

        return strongest;
    }

    private int FailedCount(ComponentEntry component) =>
        component.Scenarios.Count(s => TryGetRun(s.Id, out var r) && r.Status is "Failed" or "Error");

    /// <summary>A small mark for the scenario's result in the last automated run.</summary>
    private RenderFragment RunDot(string scenarioId) => __builder =>
    {
        if (TryGetRun(scenarioId, out var result))
        {
            var (css, symbol, text) = result.Status switch
            {
                "Passed" when result.Flaky => ("flaky", "●", "Passed after a retry (flaky)"),
                "Passed" => ("passed", "●", "Passed in the last test run"),
                "Skipped" => ("skipped", "○", "Skipped in the last test run"),
                _ => ("failed", "●", $"{result.Status} in the last test run: {result.Message}"),
            };
            <span class="wb-run wb-run-@css" title="@text"><span aria-hidden="true">@symbol</span><span class="wb-visually-hidden">@text</span></span>
        }
    };

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_built, Catalog))
        {
            _built = Catalog;
            _tree = BuildTree(Catalog);
            _large = Catalog.Components.Count > 150;
            _errors = Catalog.Issues.Count(i => i.Severity == IssueSeverity.Error);
            if (_query.Length > 0)
                Refresh();
            // Hot reload rebuilt the catalog: the files probably changed too.
            if (_changesLoaded)
                _ = InvokeAsync(async () => { await LoadChangesAsync(); StateHasChanged(); });
            _changesLoaded = true;
        }
    }

    private void Refresh()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            _matches = null;
            _pageMatches = [];
            _refMatches = [];
            return;
        }

        (_matches, _pageMatches) = Search(_query.Trim());
        _refMatches = SearchReferences(_query.Trim());
    }

    private void ToggleFilter(string token)
    {
        var parts = _query.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!parts.Remove(token))
            parts.Add(token);
        Query = string.Join(' ', parts) + (parts.Count > 0 ? " " : "");
    }

    /// <summary>
    /// Ranks scenarios: every term must match somewhere; names and titles weigh more than tags and parameters. Terms of the form
    /// <c>tag:</c>, <c>status:</c> and <c>is:</c> filter instead of scoring.
    /// </summary>
    private (List<(ComponentEntry, ScenarioDefinition)>, List<DocumentationPage>) Search(string text)
    {
        var all = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var filters = all.Where(t => t.Contains(':') && t.IndexOf(':') > 0).ToArray();
        var terms = all.Except(filters).ToArray();
        static bool Has(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

        static int Score(ComponentEntry c, ScenarioDefinition s, string t) =>
            (Has(s.Name, t) ? 3 : 0) + (Has(c.Title, t) ? 4 : 0) + (Has(c.Metadata.Name, t) ? 4 : 0) +
            (s.Tags.Concat(c.Tags).Any(tag => Has(tag, t)) ? 2 : 0) +
            (c.Metadata.Parameters.Any(p => Has(p.Name, t)) ? 1 : 0) +
            (Has(c.Description, t) || Has(s.Description, t) ? 1 : 0);

        var scenarios = Catalog.Components
            .SelectMany(c => c.Scenarios.Select(s => (c, s)))
            .Where(x => filters.All(f => Matches(x.c, x.s, f)))
            .Select(x => (x.c, x.s, scores: terms.Select(t => Score(x.c, x.s, t)).ToArray()))
            .Where(x => x.scores.All(score => score > 0))
            .OrderByDescending(x => x.scores.Sum())
            .ThenBy(x => x.c.Title, StringComparer.OrdinalIgnoreCase)
            .Select(x => (x.c, x.s))
            .ToList();
        var pages = filters.Length > 0 ? [] : Catalog.Pages.Where(p => terms.All(t => Has(p.Title, t) || Has(p.Markdown, t))).ToList();
        return (scenarios, pages);
    }

    /// <summary>Components of referenced catalogs whose title, name, summary, tags, parameters or scenarios contain every term. Filters exclude them.</summary>
    private List<(ReferencedCatalog, ReferencedComponent)> SearchReferences(string text)
    {
        var all = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (all.Any(t => t.IndexOf(':') > 0))
            return [];
        static bool Has(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
        return _references
            .SelectMany(r => r.Components.Select(c => (r, c)))
            .Where(x => all.All(t => Has(x.c.Title, t) || Has(x.c.Name, t) || Has(x.c.Summary, t) || x.c.Tags.Any(g => Has(g, t)) ||
                                     x.c.Parameters.Any(p => Has(p, t)) || x.c.Scenarios.Any(s => Has(s, t))))
            .ToList();
    }

    private bool Matches(ComponentEntry c, ScenarioDefinition s, string filter)
    {
        // -tag:legacy, -is:generated: exclude what the filter matches (Storybook's !tag).
        if (filter.Length > 1 && filter[0] == '-')
            return !Matches(c, s, filter[1..]);
        var colon = filter.IndexOf(':');
        var key = filter[..colon].ToLowerInvariant();
        var value = filter[(colon + 1)..];
        return key switch
        {
            "tag" => s.Tags.Concat(c.Tags).Any(t => string.Equals(t, value, StringComparison.OrdinalIgnoreCase)),
            "status" => c.Status is { } status && string.Equals(status.ToString(), value, StringComparison.OrdinalIgnoreCase),
            "is" => value.ToLowerInvariant() switch
            {
                "matrix" => s.Matrix is not null,
                "generated" => s.IsGenerated,
                "tested" => s.Interactions.Count > 0,
                "skipped" => s.SkipReason is not null,
                "deprecated" => c.DeprecationMessage is not null || c.Status == ComponentStatus.Deprecated,
                "documented" => c.Documentation is not null || c.Metadata.Summary is not null,
                "failing" => TryGetRun(s.Id, out var failing) && failing.Status is "Failed" or "Error",
                "passing" => TryGetRun(s.Id, out var passing) && passing.Status == "Passed",
                "flaky" => TryGetRun(s.Id, out var flaky) && flaky.Flaky,
                "pinned" => Pinned.Contains(s.Id, StringComparer.OrdinalIgnoreCase),
                "changed" => _changes.Scenarios.TryGetValue(s.Id, out var changed) && changed != ScenarioChangeKind.Related,
                "new" => _changes.Scenarios.TryGetValue(s.Id, out var added) && added == ScenarioChangeKind.New,
                "related" => _changes.Scenarios.TryGetValue(s.Id, out var related) && related == ScenarioChangeKind.Related,
                "affected" => _changes.Scenarios.ContainsKey(s.Id),
                _ => false,
            },
            _ => false,
        };
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
            return;
        if (_pageMatches.Count > 0 && (_matches is null || _matches.Count == 0))
            Navigation.NavigateTo($"pages/{_pageMatches[0].Id}");
        else if (_matches is { Count: > 0 })
            Navigation.NavigateTo($"scenario/{_matches[0].Scenario.Id}");
        else if (_refMatches.Count > 0)
            Navigation.NavigateTo(RefHref(_refMatches[0].Reference, _refMatches[0].Component));
    }

    private bool IsOpen(Node node) =>
        (SelectedScenarioId is not null && node.Contains(c => c.Scenarios.Any(s => s.Id == SelectedScenarioId))) ||
        (SelectedComponentId is not null && node.Contains(c => c.Id == SelectedComponentId)) ||
        (SelectedPageId is not null && node.ContainsPage(SelectedPageId));

    private RenderFragment RenderGroup(Node node, int depth) => __builder =>
    {
        <ul class="wb-tree">
            @foreach (var child in ExplorerOrder.Sort(Catalog.Options.ExplorerOrder, node.Children.Values, c => (c.OrderPath, c.Name,
                          c.Page is not null ? ExplorerOrder.EntryKind.Page : c.Component is not null ? ExplorerOrder.EntryKind.Component : ExplorerOrder.EntryKind.Group)))
            {
                if (child.Page is { } docPage)
                {
                    <li>
                        <a href="@($"pages/{docPage.Id}")" class="wb-node-page @(docPage.Id == SelectedPageId ? "active" : "")" aria-current="@(docPage.Id == SelectedPageId ? "page" : null)">
                            <span class="wb-icon" aria-hidden="true">▤</span>@child.Name
                        </a>
                    </li>
                }
                else if (child.Component is { } component)
                {
                    var open = IsExpanded(child.Path, component.Scenarios.Any(s => s.Id == SelectedScenarioId) || component.Id == SelectedComponentId);
                    var issues = Catalog.IssuesFor(component).Count(i => i.Severity == IssueSeverity.Error);
                    <li>
                        <details open="@open">
                            <summary class="wb-node-component" @onclick="() => Flip(child.Path, open)" @onclick:preventDefault>
                                <span class="wb-icon" aria-hidden="true">◇</span>@child.Name
                                @if (component.HasOnlyGeneratedScenarios)
                                {
                                    <span class="wb-dot" title="No declared scenarios"><span class="wb-visually-hidden">(no declared scenarios)</span></span>
                                }
                                @if (issues > 0)
                                {
                                    <span class="wb-count wb-count-error" title="@issues error(s)">@issues</span>
                                }
                                @if (FailedCount(component) is > 0 and var failed)
                                {
                                    <span class="wb-run wb-run-failed" title="@($"{failed} scenario(s) failed in the last test run")">✖ @failed</span>
                                }
                                @if (component.Status is { } status && status != ComponentStatus.Stable)
                                {
                                    <StatusBadge Status="status" Compact="true" />
                                }
                                @if (ComponentChange(component) is { } change)
                                {
                                    <span class="wb-change wb-change-@change.ToString().ToLowerInvariant()" title="@(change == ScenarioChangeKind.Related ? "Renders a changed component" : "Changed in the working copy")"><span aria-hidden="true">@(change switch { ScenarioChangeKind.New => "N", ScenarioChangeKind.Modified => "M", _ => "R" })</span><span class="wb-visually-hidden">@(change == ScenarioChangeKind.Related ? "(renders a changed component)" : "(changed)")</span></span>
                                }
                            </summary>
                            @if (open)
                            {
                            <ul class="wb-tree">
                                <li><a href="@($"docs/{component.Id}")" class="wb-node-docs @(component.Id == SelectedComponentId ? "active" : "")">Docs</a></li>
                                @foreach (var scenario in component.Scenarios)
                                {
                                    <li>
                                        <a href="@($"scenario/{scenario.Id}")" class="@(scenario.Id == SelectedScenarioId ? "active" : "")"
                                           aria-current="@(scenario.Id == SelectedScenarioId ? "page" : null)">@scenario.Name @RunDot(scenario.Id) @ChangeMark(scenario.Id)</a>
                                    </li>
                                }
                            </ul>
                            }
                        </details>
                    </li>
                }
                else
                {
                    // Large catalogs start collapsed; closed groups render no children, which keeps thousands of entries cheap.
                    var groupOpen = IsExpanded(child.Path, (!_large && depth == 0) || IsOpen(child) || node.Children.Count == 1);
                    <li>
                        <details open="@groupOpen">
                            <summary class="wb-node-group" @onclick="() => Flip(child.Path, groupOpen)" @onclick:preventDefault>@child.Name <span class="wb-muted wb-small">@child.Count</span></summary>
                            @if (groupOpen)
                            {
                                @RenderGroup(child, depth + 1)
                            }
                        </details>
                    </li>
                }
            }
        </ul>
    };

    private static Node BuildTree(WorkbenchCatalog catalog)
    {
        var root = new Node("", "");
        Node GroupFor(IReadOnlyList<string> path)
        {
            var node = root;
            for (var i = 0; i < path.Count - 1; i++)
            {
                if (!node.Children.TryGetValue("g:" + path[i], out var next))
                    node.Children["g:" + path[i]] = next = new Node(path[i], string.Join('/', path.Take(i + 1)));
                node = next;
            }

            return node;
        }

        foreach (var page in catalog.Pages)
            GroupFor(page.Path).Children["p:" + page.Id] = new Node(page.DisplayName, "page:" + page.Title) { Page = page };

        foreach (var component in catalog.Components)
            GroupFor(component.Path).Children["c:" + component.Id] = new Node(component.DisplayName, component.Title) { Component = component };

        return root;
    }

    private bool IsExpanded(string path, bool defaultOpen) => _expanded.TryGetValue(path, out var value) ? value : defaultOpen;

    private void Flip(string path, bool current) => _expanded[path] = !current;

    /// <summary>Opens every group, or closes every group and component. The selected scenario's component stays reachable.</summary>
    private void SetAllExpanded(bool open)
    {
        void Visit(Node node)
        {
            foreach (var child in node.Children.Values)
            {
                if (child.Page is not null)
                    continue;
                if (child.Component is not null)
                {
                    if (!open)
                        _expanded[child.Path] = false;
                    continue;
                }

                _expanded[child.Path] = open;
                Visit(child);
            }
        }

        Visit(_tree);
    }

    private sealed class Node(string name, string path)
    {
        public int Count => Component is not null ? 1 : Page is not null ? 0 : Children.Values.Sum(c => c.Count);

        public string Name { get; } = name;
        public string Path { get; } = path;

        /// <summary>The catalog path used by <see cref="WorkbenchOptions.ExplorerOrder"/> (pages without their <c>page:</c> prefix).</summary>
        public string OrderPath => Page?.Title ?? Path;

        public ComponentEntry? Component { get; init; }
        public DocumentationPage? Page { get; init; }
        public Dictionary<string, Node> Children { get; } = new(StringComparer.Ordinal);

        public bool Contains(Func<ComponentEntry, bool> predicate) =>
            (Component is not null && predicate(Component)) || Children.Values.Any(c => c.Contains(predicate));

        public bool ContainsPage(string id) =>
            (Page is not null && string.Equals(Page.Id, id, StringComparison.OrdinalIgnoreCase)) || Children.Values.Any(c => c.ContainsPage(id));
    }
}

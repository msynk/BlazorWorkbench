{
  "$schema": "http://json.schemastore.org/template",
  "author": "Blazor Workbench",
  "classifications": [ "Web", "Blazor", "Testing" ],
  "identity": "BlazorWorkbench.Host",
  "name": "Blazor Workbench host",
  "shortName": "blazorworkbench",
  "description": "A Blazor Workbench host to preview, test and document Razor components in isolation.",
  "sourceName": "Company.Workbench",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "WorkbenchVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "Version of the BlazorWorkbench.Hosting package.",
      "defaultValue": "0.1.0",
      "replaces": "WORKBENCH_VERSION"
    },
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [ { "choice": "net10.0" } ],
      "defaultValue": "net10.0",
      "replaces": "TARGET_FRAMEWORK"
    }
  },
  "postActions": [
    {
      "description": "Restore NuGet packages.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
